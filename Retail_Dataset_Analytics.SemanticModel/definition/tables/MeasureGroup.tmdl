			//         "<line x1='" & MarkerX & "' y1='0' x2='" & MarkerX & "' y2='24' stroke='#1A1A1A' stroke-width='2'/>" &
			//         "<text x='" & (BarWidth + 8) & "' y='16' font-size='12' fill='#000000'>" &
			//             FORMAT(CurrentSales, "#,##0") & " | " & FORMAT(PctOfTotal, "0%") &
			//         "</text>" &
			//     "</svg>"
			// RETURN
			//     SVG
			```
		lineageTag: 9e5a44b4-f544-4f8b-8893-a007b28f8210
		dataCategory: ImageUrl

	measure 'YoY Variance Bar' = ```
			
			VAR CurrentSales = [Total_Sales]
			VAR PriorSales = [Total_Sales LY]
			VAR PctChange = DIVIDE(CurrentSales - PriorSales, PriorSales)
			VAR MaxPct = 0.30
			VAR ZeroX = 90
			VAR MaxBarLength = 90
			VAR BarLength = MIN(ABS(PctChange) / MaxPct * MaxBarLength, MaxBarLength)
			VAR BarColor = IF(PctChange >= 0, "#70AD47", "#C00000")
			VAR BarX = IF(PctChange >= 0, ZeroX, ZeroX - BarLength)
			VAR MarkerX = IF(PctChange >= 0, ZeroX + BarLength, ZeroX - BarLength)
			VAR LabelText = IF(PctChange >= 0, "+", "") & FORMAT(PctChange, "0.0%")
			VAR LabelX = IF(PctChange >= 0, MarkerX + 8, MarkerX - 50)
			VAR CanvasWidth = ZeroX + MaxBarLength + 60
			VAR SVG =
			    "data:image/svg+xml;utf8," &
			    "<svg xmlns='http://www.w3.org/2000/svg' width='" & CanvasWidth & "' height='18'>" &
			        -- tight rounded background track
			        "<rect x='" & (ZeroX - MaxBarLength) & "' y='5' width='" & (MaxBarLength * 2) & "' height='8' rx='4' ry='4' fill='#EDEDED'/>" &
			        -- marker square drawn BEFORE the bar, so the bar sits on top of it
			        "<rect x='" & (MarkerX - 4) & "' y='2' width='8' height='14' fill='#000000'/>" &
			        -- colored variance bar, rounded ends, now on top of the marker
			        "<rect x='" & BarX & "' y='5' width='" & BarLength & "' height='8' rx='4' ry='4' fill='" & BarColor & "'/>" &
			        -- percentage label
			        "<text x='" & LabelX & "' y='13' font-size='15' font-weight='bold' fill='" & BarColor & "'>" &
			            LabelText &
			        "</text>" &
			    "</svg>"
			RETURN
			    SVG
			
			// YoY Variance Bar demographic = 
			// VAR CurrentSales = [Total_Sales]
			// VAR PriorSales = [Total_Sales LY]
			// VAR PctChange = DIVIDE(CurrentSales - PriorSales, PriorSales)
			// VAR MaxPct = 0.30                                    -- scale: 30% change = full bar width; adjust to your data's range
			// VAR ZeroX = 100                                      -- center point of the canvas (the "0%" reference line)
			// VAR MaxBarLength = 100                                -- max pixels the bar can extend left or right
			// VAR BarLength = MIN(ABS(PctChange) / MaxPct * MaxBarLength, MaxBarLength)
			// VAR BarColor = IF(PctChange >= 0, "#70AD47", "#C00000")   -- green if up, red if down
			// VAR BarX = IF(PctChange >= 0, ZeroX, ZeroX - BarLength)
			// VAR MarkerX = IF(PctChange >= 0, ZeroX + BarLength, ZeroX - BarLength)
			// VAR LabelText = IF(PctChange >= 0, "+", "") & FORMAT(PctChange, "0.0%")
			// VAR LabelX = IF(PctChange >= 0, MarkerX + 10, MarkerX - 55)
			// VAR SVG =
			//     "data:image/svg+xml;utf8," &
			//     "<svg xmlns='http://www.w3.org/2000/svg' width='370' height='24'>" &
			//         -- grey baseline track across full width
			//         "<line x1='0' y1='12' x2='200' y2='12' stroke='#D9D9D9' stroke-width='2'/>" &
			//         -- colored variance bar from zero point
			//         "<rect x='" & BarX & "' y='8' width='" & BarLength & "' height='8' fill='" & BarColor & "'/>" &
			//         -- marker square at the tip
			//         "<rect x='" & (MarkerX - 5) & "' y='4' width='10' height='16' fill='#000000'/>" &
			//         -- percentage label
			//         "<text x='" & LabelX & "' y='16' font-size='12' font-weight='bold' fill='" & BarColor & "'>" &
			//             LabelText &
			//         "</text>" &
			//     "</svg>"
			// RETURN
			//     SVG
			```
		lineageTag: 2b3966d2-693d-43f9-b49d-ef54e7bb364f
		dataCategory: ImageUrl

