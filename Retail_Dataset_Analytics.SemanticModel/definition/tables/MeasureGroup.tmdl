	measure 'Waterfall Value' = ```
			
			VAR MinDate = [3_Selected Min Date]
			VAR MaxDate = [2_MaxDate]
			
			VAR SelectedStep = SELECTEDVALUE ( WaterfallSteps[Step] )
			
			RETURN
			CALCULATE (
			    SWITCH ( 
			        SelectedStep,
			        "List Price",             SUM ( Fact_Sales_GPMargin[List Price] ),
			        "Retail Discount",        SUM ( Fact_Sales_GPMargin[RETAIL_DISC] ),
			        "Coupon Discount",        SUM ( Fact_Sales_GPMargin[COUPON_DISC] ),
