table MeasureGroup
	lineageTag: 3ccb7abd-36c7-4e59-93bf-b6afab01f9fa

	measure 'Selected Year' = ```
			
			VAR _MaxDate = CALCULATE(MAX(Fact_Sales_GPMargin[CalendarDate])) 
			RETURN YEAR(_MaxDate)
			```
		formatString: 0
		lineageTag: e457ea3e-3402-4fcf-b7c4-a998e2b15bcf

		changedProperty = IsHidden

	measure Last_Year_Sales = ```
			
			VAR _TY = [Selected Year]
			RETURN 
			CALCULATE(
			    [Total_Sales], 
			    REMOVEFILTERS(Dim_Date), 
			    Dim_Date[Year] = _TY - 1
			)
			
			// Last_Year_Sales = 
			// VAR _TY = [Selected Year]
			// VAR _MaxDate = CALCULATE(MAX(Fact_Sales_GPMargin[CalendarDate]))
			// VAR _M = MONTH(_MaxDate)
			// VAR _D = DAY(_MaxDate)
			// RETURN CALCULATE([Total_Sales], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = _TY - 1, Dim_Date[CalendarDate] <= DATE(_TY - 1, _M, _D))
			```
		formatString: 0
		lineageTag: ca534801-8047-4494-8995-cf8580def280

		changedProperty = IsHidden

	measure Total_Sales = ```
			
			SUM(Fact_Sales_GPMargin[SALES_VALUE])
			
			```
		lineageTag: f13def28-3e0b-4e95-b146-cdb7fdac3872

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HTML_DataCard3b =
			
			VAR ThisYear     = [Total_Sales]
			VAR LastYear     = [Last_Year_Sales]
			VAR YoYDiff      = ThisYear - LastYear
			VAR YoYPct       = DIVIDE(YoYDiff, LastYear) * 100
			VAR YoYProgress  = DIVIDE(ThisYear, LastYear) * 100
			VAR PctOfLY      = DIVIDE(ThisYear, LastYear) * 100
			
			VAR CurrentQtr   = CALCULATE([Total_Sales], DATESQTD('Dim_Date'[CalendarDate]))
			VAR PrevQtr      = CALCULATE([Total_Sales], DATESQTD(DATEADD('Dim_Date'[CalendarDate], -1, QUARTER)))
			VAR QoQDiff      = CurrentQtr - PrevQtr
			VAR QoQPct       = DIVIDE(QoQDiff, PrevQtr) * 100
			VAR QoQProgress  = DIVIDE(CurrentQtr, PrevQtr) * 100
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			VAR Sub       = IF(IsDark, "#888888", "#888888")
			VAR Divider   = IF(IsDark, "#2e2e2e", "#e5e5e5")
			VAR TrackBg   = IF(IsDark, "#333333", "#ececec")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			
			VAR YoYColor = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			VAR YoYArrow = IF(YoYPct >= 0, "▲", "▼")
			VAR QoQColor = IF(QoQPct >= 0, "#22c55e", "#ef4444")
			VAR QoQArrow = IF(QoQPct >= 0, "▲", "▼")
			
			VAR Top5Departments =
			    TOPN(5,
			        ADDCOLUMNS(VALUES(Dim_Product[DEPARTMENT]), "@Sales", [Total_Sales]),
			        [@Sales], DESC
			    )
			VAR MaxDeptSales = MAXX(Top5Departments, [@Sales])
			
			VAR DeptHtml =
			    CONCATENATEX(
			        Top5Departments,
			        "<div style='display:flex;align-items:center;font-size:11px;margin-top:4px;'>"
			        & "<span style='width:90px;color:" & TextColor & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Dim_Product[DEPARTMENT] & "</span>"
			        & "<div style='flex:1;height:6px;background:" & TrackBg & ";border-radius:3px;overflow:hidden;margin:0 6px;'>"
			        & "<div style='height:6px;background:linear-gradient(90deg,#38bdf8,#6366f1);width:" & FORMAT(DIVIDE([@Sales], MaxDeptSales)*100, "0") & "%;'></div>"
			        & "</div>"
			        & "<span style='width:70px;text-align:right;color:" & Muted & ";font-size:10px;'>$" & FORMAT([@Sales],"#,##0") & "</span>"
			        & "</div>",
			        "", [@Sales], DESC
			    )
			
			VAR Top5Commodities =
			    TOPN(5,
			        ADDCOLUMNS(VALUES(Dim_Product[COMMODITY_DESC]), "@Sales", [Total_Sales]),
			        [@Sales], DESC
			    )
			VAR MaxCommoditySales = MAXX(Top5Commodities, [@Sales])
			
			VAR CommodityHtml =
			    CONCATENATEX(
			        Top5Commodities,
			        "<div style='display:flex;align-items:center;font-size:11px;margin-top:4px;'>"
			        & "<span style='width:90px;color:" & TextColor & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Dim_Product[COMMODITY_DESC] & "</span>"
			        & "<div style='flex:1;height:6px;background:" & TrackBg & ";border-radius:3px;overflow:hidden;margin:0 6px;'>"
			        & "<div style='height:6px;background:linear-gradient(90deg,#f59e0b,#ef4444);width:" & FORMAT(DIVIDE([@Sales], MaxCommoditySales)*100, "0") & "%;'></div>"
			        & "</div>"
			        & "<span style='width:70px;text-align:right;color:" & Muted & ";font-size:10px;'>$" & FORMAT([@Sales],"#,##0") & "</span>"
			        & "</div>",
			        "", [@Sales], DESC
			    )
			
			RETURN
			"<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";overflow-y:auto;'>
			
			  <div style='display:flex;justify-content:space-between;align-items:center;'>
			    <div>
			      <div style='font-size:16px;font-weight:bold;'>Sales Performance</div>
			      <div style='font-size:11px;color:" & Muted & ";'>TY vs LY · QoQ · Top 5</div>
			    </div>
			    <div style='background:" & YoYColor & ";color:#ffffff;font-size:11px;font-weight:bold;padding:4px 8px;border-radius:6px;'>" & YoYArrow & " " & FORMAT(YoYPct,"0.0") & "%</div>
			  </div>
			
			  <div style='margin-top:14px;font-size:22px;color:" & YoYColor & ";font-weight:bold;'>$" & FORMAT(ThisYear,"#,##0") & "</div>
			  <div style='font-size:11px;color:" & Muted & ";'>This Year Sales</div>
			
			  <div style='display:flex;justify-content:space-between;font-size:11px;color:" & Muted & ";margin-top:10px;'>
			    <span>Last Year: $" & FORMAT(LastYear,"#,##0") & "</span>
			    <span>Δ $" & FORMAT(YoYDiff,"#,##0") & "</span>
			  </div>
			
			  <div style='width:100%;height:8px;background:" & TrackBg & ";border-radius:5px;overflow:hidden;margin-top:6px;'>
			    <div style='height:8px;background:linear-gradient(90deg,#facc15,#f97316);width:" & MIN(YoYProgress,200) & "%;'></div>
			  </div>
			  <div style='display:flex;justify-content:space-between;font-size:10px;color:" & Sub & ";margin-top:3px;'>
			    <span>0%</span><span>" & FORMAT(YoYProgress,"0") & "% of LY</span><span>200%</span>
			  </div>
			
			  <div style='height:1px;background:" & Divider & ";margin:14px 0;'></div>
			
			  <div style='display:flex;justify-content:space-between;align-items:center;'>
			    <div style='font-size:12px;font-weight:bold;color:" & TextColor & ";'>Quarter on Quarter</div>
			    <div style='background:" & QoQColor & ";color:#ffffff;font-size:11px;font-weight:bold;padding:3px 7px;border-radius:6px;'>" & QoQArrow & " " & FORMAT(QoQPct,"0.0") & "%</div>
			  </div>
			
			  <div style='display:flex;justify-content:space-between;margin-top:8px;'>
			    <div>
			      <div style='font-size:10px;color:" & Sub & ";'>Current Q</div>
			      <div style='font-size:14px;font-weight:bold;color:" & TextColor & ";'>$" & FORMAT(CurrentQtr,"#,##0") & "</div>
			    </div>
			    <div style='text-align:right;'>
			      <div style='font-size:10px;color:" & Sub & ";'>Previous Q</div>
			      <div style='font-size:14px;font-weight:bold;color:" & Muted & ";'>$" & FORMAT(PrevQtr,"#,##0") & "</div>
			    </div>
			  </div>
			
			  <div style='width:100%;height:6px;background:" & TrackBg & ";border-radius:4px;overflow:hidden;margin-top:8px;'>
			    <div style='height:6px;background:linear-gradient(90deg,#38bdf8,#6366f1);width:" & MIN(QoQProgress,200) & "%;'></div>
			  </div>
			
			  <div style='height:1px;background:" & Divider & ";margin:14px 0 8px 0;'></div>
			
			  <div style='font-size:12px;font-weight:bold;color:" & TextColor & ";'>Top 5 Departments</div>
			  " & DeptHtml & "
			
			  <div style='height:1px;background:" & Divider & ";margin:12px 0 8px 0;'></div>
			
			  <div style='font-size:12px;font-weight:bold;color:" & TextColor & ";'>Top 5 Commodities</div>
			  " & CommodityHtml & "
			
			  <div style='height:1px;background:" & Divider & ";margin:14px 0 10px 0;'></div>
			
			  <div style='display:flex;justify-content:space-between;text-align:center;'>
			    <div style='flex:1;'>
			      <div style='font-size:10px;color:" & Sub & ";'>YoY Δ</div>
			      <div style='font-size:13px;font-weight:bold;color:" & YoYColor & ";'>$" & FORMAT(YoYDiff,"#,##0") & "</div>
			    </div>
			    <div style='flex:1;border-left:1px solid " & Divider & ";border-right:1px solid " & Divider & ";'>
			      <div style='font-size:10px;color:" & Sub & ";'>% of LY</div>
			      <div style='font-size:13px;font-weight:bold;color:#f59e0b;'>" & FORMAT(PctOfLY,"0.0") & "%</div>
			    </div>
			    <div style='flex:1;'>
			      <div style='font-size:10px;color:" & Sub & ";'>QoQ Δ</div>
			      <div style='font-size:13px;font-weight:bold;color:" & QoQColor & ";'>$" & FORMAT(QoQDiff,"#,##0") & "</div>
			    </div>
			  </div>
			
			</div>"
		lineageTag: 13af6c68-46a7-43b0-a2a6-abd80e66c049

		changedProperty = IsHidden

	measure HTML_RevenueBridge = ```
			
			VAR ThisYear     = [Total_Sales]
			VAR LastYear     = [Last_Year_Sales]
			VAR YoYDiff      = ThisYear - LastYear
			VAR YoYPct       = DIVIDE(YoYDiff, LastYear) * 100
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			VAR BarLight  = IF(IsDark, "#4a4a4a", "#d9d9d9")
			VAR BarDark   = IF(IsDark, "#e5e5e5", "#3a3a3a")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			
			VAR YoYColor = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			VAR YoYArrow = IF(YoYPct >= 0, "▲", "▼")
			
			VAR FmtK = 
			    SWITCH(TRUE(),
			        ABS(ThisYear) >= 1000000, "$" & FORMAT(ThisYear/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ThisYear/1000, "#,##0.0") & "K"
			    )
			VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			VAR MaxVal    = MAX(ThisYear, LastYear)
			VAR LYBarH    = ROUND(DIVIDE(LastYear, MaxVal) * 100, 0)
			VAR TYBarH    = ROUND(DIVIDE(ThisYear, MaxVal) * 100, 0)
			VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 4)
			VAR DiffBottom = MIN(LYBarH, TYBarH)
			
			RETURN
			"<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";text-align:center;'>
			
			  <div style='font-size:13px;font-weight:bold;color:" & TextColor & ";'>Revenue</div>
			  <div style='font-size:26px;font-weight:bold;margin-top:6px;color:" & TextColor & ";'>" & FmtK & "</div>
			
			  <div style='display:flex;justify-content:center;align-items:center;gap:4px;margin-top:10px;'>
			    <span style='font-size:11px;color:" & Muted & ";'>ΔLY</span>
			    <span style='font-size:13px;font-weight:bold;color:" & YoYColor & ";'>" & FORMAT(YoYPct,"+0.0") & "%</span>
			    <span style='color:" & YoYColor & ";font-size:12px;'>" & YoYArrow & "</span>
			  </div>
			
			  <div style='display:flex;justify-content:center;align-items:flex-end;gap:16px;margin-top:26px;height:130px;'>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & LYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & LYBarH & "px;background:" & BarLight & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>LY</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;font-weight:bold;color:" & YoYColor & ";margin-bottom:4px;'>" & DiffFmtK & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:" & DiffBottom & "px;width:34px;height:" & DiffBarH & "px;background:" & YoYColor & ";border-radius:3px;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>Δ</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & TYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & TYBarH & "px;background:" & BarDark & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>TY</div>
			    </div>
			
			  </div>
			
			</div>"
			
			// HTML_RevenueBridge = 
			// VAR ThisYear     = [Total_Sales]
			// VAR LastYear     = [Last_Year_Sales]
			// VAR YoYDiff      = ThisYear - LastYear
			// VAR YoYPct       = DIVIDE(YoYDiff, LastYear) * 100
			
			// //VAR CurrentQtr   = CALCULATE([Total_Sales], DATESQTD('Dim_Date'[CalendarDate]))
			// //VAR PrevQtr      = CALCULATE([Total_Sales], DATESQTD(DATEADD('Dim_Date'[CalendarDate], -1, QUARTER)))
			// //VAR QoQDiff      = CurrentQtr - PrevQtr
			// //VAR QoQPct       = DIVIDE(QoQDiff, PrevQtr) * 100
			
			// VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			// VAR IsDark    = ThemeMode = "Dark"
			// VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			// VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			// VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			// VAR BarLight  = IF(IsDark, "#4a4a4a", "#d9d9d9")
			// VAR BarDark   = IF(IsDark, "#e5e5e5", "#3a3a3a")
			// VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			
			// VAR YoYColor = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			// VAR YoYArrow = IF(YoYPct >= 0, "▲", "▼")
			// //VAR QoQColor = IF(QoQPct >= 0, "#22c55e", "#ef4444")
			// //VAR QoQArrow = IF(QoQPct >= 0, "▲", "▼")
			
			// VAR FmtK = 
			//     SWITCH(TRUE(),
			//         ABS(ThisYear) >= 1000000, "$" & FORMAT(ThisYear/1000000, "#,##0.0") & "M",
			//         "$" & FORMAT(ThisYear/1000, "#,##0.0") & "K"
			//     )
			// VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			// VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			// VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			// -- Bar heights out of a 100px track, scaled to the larger of LY/TY
			// VAR MaxVal    = MAX(ThisYear, LastYear)
			// VAR LYBarH    = ROUND(DIVIDE(LastYear, MaxVal) * 100, 0)
			// VAR TYBarH    = ROUND(DIVIDE(ThisYear, MaxVal) * 100, 0)
			// VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 4)   -- min 4px so it's always visible
			// VAR DiffBottom = MIN(LYBarH, TYBarH)           -- floats starting from the shorter bar
			
			// RETURN
			// "<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";text-align:center;'>
			
			//   <div style='font-size:13px;font-weight:bold;color:" & TextColor & ";'>Revenue</div>
			//   <div style='font-size:26px;font-weight:bold;margin-top:6px;color:" & TextColor & ";'>" & FmtK & "</div>
			
			//   <div style='display:flex;justify-content:center;align-items:center;gap:4px;margin-top:10px;'>
			//     <span style='font-size:11px;color:" & Muted & ";'>ΔLY</span>
			//     <span style='font-size:13px;font-weight:bold;color:" & YoYColor & ";'>" & FORMAT(YoYPct,"+0.0") & "%</span>
			//     <span style='color:" & YoYColor & ";font-size:12px;'>" & YoYArrow & "</span>
			//   </div>
			
			//   <div style='display:flex;justify-content:center;align-items:flex-end;gap:16px;margin-top:26px;height:130px;'>
			
			//     <div style='display:flex;flex-direction:column;align-items:center;'>
			//       <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & LYLabel & "</div>
			//       <div style='position:relative;width:34px;height:100px;'>
			//         <div style='position:absolute;bottom:0;width:34px;height:" & LYBarH & "px;background:" & BarLight & ";border-radius:3px 3px 0 0;'></div>
			//       </div>
			//       <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>LY</div>
