	measure Total_COGS =
			SUM(Fact_Sales_GPMargin[Estimated_COGS])
			
			// Total_COGS = SUMX(Fact_Sales_GPMargin, Fact_Sales_GPMargin[Estimated_COGS])
		lineageTag: e25a428c-265e-44f9-9806-5aba15c6012a

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Gross_Profit =
			SUM(Fact_Sales_GPMargin[Estimated_Gross_Profit])
			
			// Total_Gross_Profit = SUMX(Fact_Sales_GPMargin, Fact_Sales_GPMargin[Estimated_Gross_Profit])
		lineageTag: 28ca503c-4885-47b0-9386-e4464ab30167

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Last_Year_COGS =
			
			VAR _TY = [Selected Year]
			VAR _MaxDate = CALCULATE(MAX(Fact_Sales_GPMargin[CalendarDate]))
			VAR _M = MONTH(_MaxDate)
			VAR _D = DAY(_MaxDate)
			RETURN CALCULATE([Total_COGS], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = _TY - 1, Dim_Date[CalendarDate] <= DATE(_TY - 1, _M, _D))
		lineageTag: b9151288-dad9-411c-8494-3e474e009aef

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Last_Year_Gross_Profit =
			
			VAR _TY = [Selected Year]
			VAR _MaxDate = CALCULATE(MAX(Fact_Sales_GPMargin[CalendarDate]))
			VAR _M = MONTH(_MaxDate)
			VAR _D = DAY(_MaxDate)
			RETURN CALCULATE([Total_Gross_Profit], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = _TY - 1, Dim_Date[CalendarDate] <= DATE(_TY - 1, _M, _D))
		lineageTag: 8be6c2f1-0f02-466f-89a3-94e72d3a3819

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure HTML_COGSBridge = ```
			
			VAR ThisYear     = [Total_COGS]
			VAR LastYear     = [Last_Year_COGS]
			VAR YoYDiff      = ThisYear - LastYear
			VAR YoYPct       = DIVIDE(YoYDiff, LastYear) * 100
			
			VAR TYRatio = DIVIDE(ThisYear, [Total_Sales])
			VAR LYRatio = DIVIDE(LastYear, [Last_Year_Sales])
			VAR RatioDiff = TYRatio - LYRatio
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			VAR BarLight  = IF(IsDark, "#4a4a4a", "#d9d9d9")
			VAR BarDark   = IF(IsDark, "#e5e5e5", "#3a3a3a")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			
			VAR YoYColor = IF(RatioDiff <= 0, "#22c55e", "#ef4444")
			VAR YoYArrow = IF(YoYPct >= 0, "▲", "▼")
			
			VAR FmtK = 
			    SWITCH(TRUE(),
			        ABS(ThisYear) >= 1000000, "$" & FORMAT(ThisYear/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ThisYear/1000, "#,##0.0") & "K"
			    )
			VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			VAR MaxVal    = MAX(ThisYear, LastYear)
			VAR LYBarH    = ROUND(DIVIDE(LastYear, MaxVal) * 100, 0)
			VAR TYBarH    = ROUND(DIVIDE(ThisYear, MaxVal) * 100, 0)
			VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 4)
			VAR DiffBottom = MIN(LYBarH, TYBarH)
			
			RETURN
			"<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";text-align:center;'>
			
			  <div style='font-size:13px;font-weight:bold;color:" & TextColor & ";'>COGS</div>
			  <div style='font-size:26px;font-weight:bold;margin-top:6px;color:" & TextColor & ";'>" & FmtK & "</div>
			
			  <div style='display:flex;justify-content:center;align-items:center;gap:4px;margin-top:10px;'>
			    <span style='font-size:11px;color:" & Muted & ";'>ΔLY</span>
			    <span style='font-size:13px;font-weight:bold;color:" & YoYColor & ";'>" & FORMAT(YoYPct,"+0.0") & "%</span>
			    <span style='color:" & YoYColor & ";font-size:12px;'>" & YoYArrow & "</span>
			  </div>
			
			  <div style='display:flex;justify-content:center;align-items:flex-end;gap:16px;margin-top:26px;height:130px;'>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & LYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & LYBarH & "px;background:" & BarLight & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>LY</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;font-weight:bold;color:" & YoYColor & ";margin-bottom:4px;'>" & DiffFmtK & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:" & DiffBottom & "px;width:34px;height:" & DiffBarH & "px;background:" & YoYColor & ";border-radius:3px;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>Δ</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & TYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & TYBarH & "px;background:" & BarDark & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>TY</div>
			    </div>
			
			  </div>
			
			</div>"
			```
		lineageTag: 82a45f4c-d7eb-43bb-99a6-c1152a41585a

		changedProperty = IsHidden

	measure HTML_GrossProfitBridge = ```
			
			VAR ThisYear     = [Total_Gross_Profit]
			VAR LastYear     = [Last_Year_Gross_Profit]
			VAR YoYDiff      = ThisYear - LastYear
			VAR YoYPct       = DIVIDE(YoYDiff, LastYear) * 100
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			VAR BarLight  = IF(IsDark, "#4a4a4a", "#d9d9d9")
			VAR BarDark   = IF(IsDark, "#e5e5e5", "#3a3a3a")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			
			VAR YoYColor = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			VAR YoYArrow = IF(YoYPct >= 0, "▲", "▼")
			
			VAR FmtK = 
			    SWITCH(TRUE(),
			        ABS(ThisYear) >= 1000000, "$" & FORMAT(ThisYear/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ThisYear/1000, "#,##0.0") & "K"
			    )
			VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			VAR MaxVal    = MAX(ThisYear, LastYear)
			VAR LYBarH    = ROUND(DIVIDE(LastYear, MaxVal) * 100, 0)
			VAR TYBarH    = ROUND(DIVIDE(ThisYear, MaxVal) * 100, 0)
			VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 4)
			VAR DiffBottom = MIN(LYBarH, TYBarH)
			
			RETURN
			"<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";text-align:center;'>
			
			  <div style='font-size:13px;font-weight:bold;color:" & TextColor & ";'>Gross Profit</div>
			  <div style='font-size:26px;font-weight:bold;margin-top:6px;color:" & TextColor & ";'>" & FmtK & "</div>
			
			  <div style='display:flex;justify-content:center;align-items:center;gap:4px;margin-top:10px;'>
			    <span style='font-size:11px;color:" & Muted & ";'>ΔLY</span>
			    <span style='font-size:13px;font-weight:bold;color:" & YoYColor & ";'>" & FORMAT(YoYPct,"+0.0") & "%</span>
			    <span style='color:" & YoYColor & ";font-size:12px;'>" & YoYArrow & "</span>
			  </div>
			
			  <div style='display:flex;justify-content:center;align-items:flex-end;gap:16px;margin-top:26px;height:130px;'>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & LYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & LYBarH & "px;background:" & BarLight & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>LY</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;font-weight:bold;color:" & YoYColor & ";margin-bottom:4px;'>" & DiffFmtK & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:" & DiffBottom & "px;width:34px;height:" & DiffBarH & "px;background:" & YoYColor & ";border-radius:3px;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>Δ</div>
			    </div>
			
			    <div style='display:flex;flex-direction:column;align-items:center;'>
			      <div style='font-size:10px;color:" & Muted & ";margin-bottom:4px;'>" & TYLabel & "</div>
			      <div style='position:relative;width:34px;height:100px;'>
			        <div style='position:absolute;bottom:0;width:34px;height:" & TYBarH & "px;background:" & BarDark & ";border-radius:3px 3px 0 0;'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>TY</div>
			    </div>
			
			  </div>
			
			</div>"
			```
		lineageTag: acecdb05-0625-4326-a569-b134ccd5e2e3

		changedProperty = IsHidden

	measure HTML_MonthlyGPVariance = ```
			
			VAR SelYear = [Selected Year]
			
			VAR MonthsTbl =
			    ADDCOLUMNS(
			        VALUES(Dim_Date[Month]),
			        "@Month", Dim_Date[Month],
			        "@MonthName", CALCULATE(SELECTEDVALUE(Dim_Date[MonthName])),
			        "@AC", CALCULATE([Total_Gross_Profit], Dim_Date[Year] = SelYear),
			        "@LY", CALCULATE([Total_Gross_Profit], Dim_Date[Year] = SelYear - 1)
			    )
			
			VAR FilteredTbl = FILTER(MonthsTbl, [@AC] > 0 || [@LY] > 0)
			
			VAR EnrichedTbl =
			    ADDCOLUMNS(
			        FilteredTbl,
			        "@Delta", [@AC] - [@LY],
			        "@DeltaPct", DIVIDE([@AC] - [@LY], [@LY]) * 100
			    )
			
			VAR MaxScale  = MAXX(EnrichedTbl, IF([@AC] > [@LY], [@AC], [@LY]))
			VAR LastMonth = MAXX(EnrichedTbl, [@Month])
			
			VAR TotalAC    = SUMX(EnrichedTbl, [@AC])
			VAR TotalLY    = SUMX(EnrichedTbl, [@LY])
			VAR OverallPct = DIVIDE(TotalAC - TotalLY, TotalLY) * 100
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#18181b", "#ffffff")
			VAR TextColor = IF(IsDark, "#f4f4f5", "#18181b")
			VAR Muted     = IF(IsDark, "#a1a1aa", "#64748b")
			VAR BarAC     = IF(IsDark, "#38bdf8", "#0284c7")
			VAR BarLY     = IF(IsDark, "#3f3f46", "#cbd5e1")
			VAR BaseLine  = IF(IsDark, "#52525b", "#e2e8f0")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.4)", "0 4px 12px rgba(0,0,0,0.08)")
			
			VAR ColumnPrep =
			    ADDCOLUMNS(
			        EnrichedTbl,
			        "@PosColor", IF([@DeltaPct] >= 0, "#22c55e", "#ef4444"),
			        "@ACH", 
			            IF(
			                MaxScale = 0, 
			                "0%", 
			                FORMAT(IF(DIVIDE([@AC], MaxScale) * 100 < 3, 3, DIVIDE([@AC], MaxScale) * 100), "0.0") & "%"
			            ),
			        "@LYH", 
			            IF(
			                MaxScale = 0, 
			                "0%", 
			                FORMAT(IF(DIVIDE([@LY], MaxScale) * 100 < 3, 3, DIVIDE([@LY], MaxScale) * 100), "0.0") & "%"
			            ),
			        "@DeltaLbl", IF([@Delta] >= 0, "+", "") & FORMAT([@Delta] / 1000, "#,##0"),
			        "@HighlightBorder", IF([@Month] = LastMonth, "border:2px solid #3b82f6;border-radius:16px;", "")
			    )
			
			VAR ColumnsHTML =
			    CONCATENATEX(
			        ColumnPrep,
			        "<div style='flex:1;display:flex;flex-direction:column;align-items:center;min-width:40px;height:100%;'>" &
			          /* 1. Variance Line & Fixed Percentage Position */
			          "<div style='position:relative;width:100%;height:32px;flex-shrink:0;'>" &
			            "<div style='position:absolute;top:22px;left:0;right:0;height:1px;background:" & BaseLine & ";'></div>" &
			            /* 'top:2px' ensures all month percentage labels rest on the exact same horizontal level */
			            "<div style='position:absolute;left:50%;transform:translateX(-50%);top:2px;font-size:11px;font-weight:bold;color:" & [@PosColor] & ";white-space:nowrap;padding:1px 4px;" & [@HighlightBorder] & "'>" & FORMAT([@DeltaPct], "+0.0") & "%</div>" &
			          "</div>" &
			          /* 2. Delta Label */
			          "<div style='font-size:11px;font-weight:bold;color:" & [@PosColor] & ";margin-top:2px;flex-shrink:0;'>" & [@DeltaLbl] & "</div>" &
			          /* 3. Overlapping & Offset Bars Container */
			          "<div style='position:relative;flex:1;width:100%;margin:10px 0;min-height:40px;'>" &
			            "<div style='position:absolute;bottom:0;left:50%;transform:translateX(-70%);width:22px;height:" & [@LYH] & ";background:" & BarLY & ";border-radius:3px 3px 0 0;'></div>" &
			            "<div style='position:absolute;bottom:0;left:50%;transform:translateX(-20%);width:14px;height:" & [@ACH] & ";background:" & BarAC & ";border-radius:2px 2px 0 0;box-shadow: -2px 0 6px rgba(0,0,0,0.35);'></div>" &
			          "</div>" &
			          /* 4. Actual Amount */
			          "<div style='font-size:11px;color:" & TextColor & ";font-weight:bold;flex-shrink:0;'>" & FORMAT([@AC] / 1000, "#,##0") & "</div>" &
			          /* 5. Month Name */
			          "<div style='font-size:11px;color:" & Muted & ";margin-top:4px;flex-shrink:0;'>" & [@MonthName] & "</div>" &
			        "</div>",
			        "",
			        [@Month], ASC
			    )
			
			RETURN
			"<div style='position:absolute;top:0;bottom:0;left:0;right:0;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:18px;border-radius:12px;font-family:Segoe UI, Arial, sans-serif;box-shadow:" & Shadow & ";display:flex;flex-direction:column;overflow:hidden;'>" &
			  "<div style='display:flex;justify-content:space-between;align-items:baseline;flex-shrink:0;'>" &
			    "<div style='display:flex;align-items:center;gap:12px;'>" &
			      "<span style='font-size:16px;font-weight:bold;'>Gross Profit — AC vs LY by Month (in K)</span>" &
			      "<span style='font-size:11px;color:" & Muted & ";display:flex;align-items:center;gap:8px;'>" &
			        "<span style='display:inline-block;width:10px;height:10px;background:" & BarAC & ";border-radius:2px;'></span>AC " &
			        "<span style='display:inline-block;width:10px;height:10px;background:" & BarLY & ";border-radius:2px;margin-left:4px;'></span>LY" &
			      "</span>" &
			    "</div>" &
			    "<div style='font-size:14px;font-weight:bold;color:" & IF(OverallPct >= 0, "#22c55e", "#ef4444") & ";'>" & FORMAT(OverallPct, "+0.0") & "% overall</div>" &
			  "</div>" &
			  "<div style='display:flex;width:100%;flex:1;margin-top:14px;align-items:stretch;'>" &
			    ColumnsHTML &
			  "</div>" &
			"</div>"
			```
		lineageTag: 6b1326af-51a8-4534-b552-a590394493e3

	measure HTML_SalesWaterfall =
			
			VAR SelYear = [Selected Year]
			VAR MaxDate = CALCULATE(MAX(Fact_Sales_GPMargin[CalendarDate]))
			VAR LastDayOfCurrentMonth = EOMONTH(MaxDate, 0)
			VAR CurrentMonthComplete = DAY(MaxDate) = DAY(LastDayOfCurrentMonth)
			VAR LastCompleteMonth = IF(CurrentMonthComplete, MONTH(MaxDate), MONTH(MaxDate) - 1)
			
			VAR MonthsTbl =
			    FILTER(
			        ADDCOLUMNS(
			            VALUES(Dim_Date[Month]),
			            "@MonthName", CALCULATE(SELECTEDVALUE(Dim_Date[MonthName])),
			            "@AC", CALCULATE([Total_Sales], Dim_Date[Year] = SelYear),
			            "@PY", CALCULATE([Total_Sales], Dim_Date[Year] = SelYear - 1)
			        ),
			        [Month] <= LastCompleteMonth
			    )
			
			VAR EnrichedTbl =
			    ADDCOLUMNS(
			        MonthsTbl,
			        "@Delta", [@AC] - [@PY],
			        "@DeltaPct", DIVIDE([@AC] - [@PY], [@PY]) * 100
			    )
			
			VAR PYTotal = CALCULATE([Total_Sales], REMOVEFILTERS(Dim_Date), Dim_Date[Year] = SelYear - 1)
			VAR ACTotal = SUMX(EnrichedTbl, [@AC])
			VAR TotalDelta = ACTotal - PYTotal
			VAR TotalDeltaPct = DIVIDE(TotalDelta, PYTotal) * 100
			
			VAR RunningTbl =
			    ADDCOLUMNS(
			        EnrichedTbl,
			        "@RunningBefore",
			            VAR CurMonth = [Month]
			            RETURN PYTotal + SUMX(FILTER(EnrichedTbl, [Month] < CurMonth), [@Delta]),
			        "@RunningAfter",
			            VAR CurMonth = [Month]
			            RETURN PYTotal + SUMX(FILTER(EnrichedTbl, [Month] <= CurMonth), [@Delta])
			    )
			
			VAR MaxScale =
			    MAX(
			        PYTotal,
			        MAX(
			            ACTotal,
			            MAXX(RunningTbl, MAX([@RunningBefore], [@RunningAfter]))
			        )
			    )
			
			VAR ThemeMode = SELECTEDVALUE('Theme'[Mode], "Dark")
			VAR IsDark    = ThemeMode = "Dark"
			VAR BgColor   = IF(IsDark, "#1e1e1e", "#ffffff")
			VAR TextColor = IF(IsDark, "#ffffff", "#1a1a1a")
			VAR Muted     = IF(IsDark, "#aaaaaa", "#555555")
			VAR PYBarClr  = IF(IsDark, "#8a8a8a", "#c9c9c9")
			VAR ACBarClr  = IF(IsDark, "#e5e5e5", "#3a3a3a")
			VAR Shadow    = IF(IsDark, "0 4px 12px rgba(0,0,0,0.35)", "0 4px 12px rgba(0,0,0,0.08)")
			VAR TrackH    = 140
			
			VAR StartHtml =
			    "<div style='display:flex;flex-direction:column;align-items:center;min-width:40px;'>
			      <div style='font-size:10px;font-weight:bold;color:" & TextColor & ";margin-bottom:4px;'>" & FORMAT(PYTotal/1000,"#,##0") & "</div>
			      <div style='position:relative;width:32px;height:" & TrackH & "px;'>
			        <div style='position:absolute;bottom:0;width:32px;height:" & ROUND(DIVIDE(PYTotal, MaxScale) * TrackH, 0) & "px;background:" & PYBarClr & ";'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;font-weight:bold;'>PY</div>
			    </div>"
			
			VAR WaterfallHtml =
			    CONCATENATEX(
			        RunningTbl,
			        VAR PosColor = IF([@Delta] >= 0, "#22c55e", "#ef4444")
			        VAR BarBottom = ROUND(DIVIDE(MIN([@RunningBefore], [@RunningAfter]), MaxScale) * TrackH, 0)
			        VAR BarHeight = MAX(ROUND(DIVIDE(ABS([@Delta]), MaxScale) * TrackH, 0), 3)
			        VAR DeltaLbl = IF([@Delta] >= 0, "+", "") & FORMAT([@Delta]/1000, "#,##0")
			        RETURN
			        "<div style='display:flex;flex-direction:column;align-items:center;min-width:40px;'>
			          <div style='font-size:9px;font-weight:bold;color:" & PosColor & ";margin-bottom:4px;white-space:nowrap;'>" & DeltaLbl & " (" & FORMAT([@DeltaPct],"+0.0") & "%)</div>
			          <div style='position:relative;width:28px;height:" & TrackH & "px;'>
			            <div style='position:absolute;bottom:" & BarBottom & "px;width:28px;height:" & BarHeight & "px;background:" & PosColor & ";'></div>
			          </div>
			          <div style='font-size:10px;color:" & Muted & ";margin-top:5px;'>" & [@MonthName] & "</div>
			        </div>",
			        "",
			        [Month], ASC
			    )
			
			VAR EndHtml =
			    "<div style='display:flex;flex-direction:column;align-items:center;min-width:40px;'>
			      <div style='font-size:10px;font-weight:bold;color:" & TextColor & ";margin-bottom:4px;'>" & FORMAT(ACTotal/1000,"#,##0") & "</div>
			      <div style='position:relative;width:32px;height:" & TrackH & "px;'>
			        <div style='position:absolute;bottom:0;width:32px;height:" & ROUND(DIVIDE(ACTotal, MaxScale) * TrackH, 0) & "px;background:" & ACBarClr & ";'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;font-weight:bold;'>AC</div>
			    </div>"
			
			VAR TotalDeltaColor = IF(TotalDelta >= 0, "#22c55e", "#ef4444")
			VAR TotalDeltaBottom = ROUND(DIVIDE(MIN(PYTotal, ACTotal), MaxScale) * TrackH, 0)
			VAR TotalDeltaHeight = MAX(ROUND(DIVIDE(ABS(TotalDelta), MaxScale) * TrackH, 0), 3)
			VAR TotalDeltaLbl = IF(TotalDelta >= 0, "+", "") & FORMAT(TotalDelta/1000, "#,##0")
			
			VAR DeltaHtml =
			    "<div style='display:flex;flex-direction:column;align-items:center;min-width:40px;'>
			      <div style='font-size:9px;font-weight:bold;color:" & TotalDeltaColor & ";margin-bottom:4px;white-space:nowrap;'>" & TotalDeltaLbl & " (" & FORMAT(TotalDeltaPct,"+0.0") & "%)</div>
			      <div style='position:relative;width:28px;height:" & TrackH & "px;'>
			        <div style='position:absolute;bottom:" & TotalDeltaBottom & "px;width:28px;height:" & TotalDeltaHeight & "px;background:" & TotalDeltaColor & ";'></div>
			      </div>
			      <div style='font-size:10px;color:" & Muted & ";margin-top:5px;font-weight:bold;'>&#916;PY</div>
			    </div>"
			
			RETURN
			"<div style='width:100%;height:100%;box-sizing:border-box;background:" & BgColor & ";color:" & TextColor & ";padding:16px;border-radius:12px;font-family:Arial;box-shadow:" & Shadow & ";overflow-x:auto;'>
			
			  <div style='font-size:14px;font-weight:bold;'>Net Sales — PY to AC Bridge (in K)</div>
			  <div style='font-size:11px;color:" & Muted & ";margin-bottom:4px;'>Jan-" & UPPER(LEFT(FORMAT(DATE(2000,LastCompleteMonth,1),"MMM"),3)) & " only (excludes incomplete trailing month)</div>
			
			  <div style='display:flex;align-items:flex-end;gap:6px;margin-top:20px;'>
			    " & StartHtml & WaterfallHtml & EndHtml & DeltaHtml & "
			  </div>
			
			</div>"
		lineageTag: 8da4cd5d-1256-4401-88a7-f5811c034949

