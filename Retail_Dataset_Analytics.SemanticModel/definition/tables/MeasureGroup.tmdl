	measure HTML_RevenueBridge1 = ```
			
			VAR MaxDate   = CALCULATE(MAX('Dim_Date'[CalendarDate]), ALL('Dim_Date'))
			VAR MinDate   = CALCULATE(MIN('Dim_Date'[CalendarDate]), ALL('Dim_Date'))
			
			VAR SelectedPeriod = SELECTEDVALUE('Date Selection'[Date Selection], "TY")
			
			VAR PeriodStart = [3_Selected Min Date]
			VAR PeriodEnd   = [2_MaxDate]
			VAR PeriodStartLY = DATE(YEAR(PeriodStart)-1, MONTH(PeriodStart), DAY(PeriodStart))
			VAR PeriodEndLY   = DATE(YEAR(PeriodEnd)-1, MONTH(PeriodEnd), DAY(PeriodEnd))
			
			VAR ThisYear = CALCULATE([3_Selected Measure], KEEPFILTERS(DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStart, PeriodEnd)))
			VAR LastYear = CALCULATE([3_Selected Measure], KEEPFILTERS(DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStartLY, PeriodEndLY)))
			
			VAR YoYDiff = ThisYear - LastYear
			VAR YoYPct  = DIVIDE(YoYDiff, LastYear) * 100
			
			VAR TextColor = "#1a1a1a"
			VAR Muted     = "#666666"
			VAR BarLight  = "#9dc9f7"
			VAR BarDark   = "#0f3d66"
			VAR YoYColor  = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			VAR YoYArrow  = IF(YoYPct >= 0, "▲", "▼")
			
			VAR FmtK = 
			    SWITCH(TRUE(),
			        ABS(ThisYear) >= 1000000, "$" & FORMAT(ThisYear/1000000, "#,##0.0") & "M",
			        "$" & FORMAT(ThisYear/1000, "#,##0.0") & "K"
			    )
			VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			-- Wider vertical grid (320 x 190) with more headroom before bars start
			VAR BarTop    = 92
			VAR BarBottom = 172
			VAR BarAreaH  = BarBottom - BarTop
			VAR MaxVal    = MAX(ThisYear, LastYear)
			VAR LYBarH    = ROUND(BarAreaH * DIVIDE(LastYear, MaxVal), 1)
			VAR TYBarH    = ROUND(BarAreaH * DIVIDE(ThisYear, MaxVal), 1)
			VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 6)
			VAR DiffBottomH = MIN(LYBarH, TYBarH)
			
			VAR LYy   = BarBottom - LYBarH
			VAR TYy   = BarBottom - TYBarH
			VAR Diffy = BarBottom - DiffBottomH - DiffBarH
			
			VAR LYx = 46
			VAR Diffx = 142
			VAR TYx = 238
			VAR BarW = 40
			
			RETURN
			"<svg width='100%' height='100%' viewBox='0 0 320 190' preserveAspectRatio='xMidYMid meet' xmlns='http://www.w3.org/2000/svg' font-family='Arial'>
			
			  <text x='10' y='20' font-size='14' font-weight='bold' fill='" & TextColor & "'>Revenue</text>
			  <text x='10' y='48' font-size='26' font-weight='800' fill='" & TextColor & "'>" & FmtK & "</text>
			
			  <text x='10' y='66' font-size='10' fill='" & Muted & "'>ΔLY</text>
			  <text x='34' y='66' font-size='11' font-weight='bold' fill='" & YoYColor & "'>" & FORMAT(YoYPct,"+0.0") & "% " & YoYArrow & "</text>
			
			  <!-- LY bar -->
			  <text x='" & LYx + BarW/2 & "' y='" & LYy - 8 & "' font-size='9' fill='" & Muted & "' text-anchor='middle'>" & LYLabel & "</text>
			  <rect x='" & LYx & "' y='" & LYy & "' width='" & BarW & "' height='" & LYBarH & "' rx='3' fill='" & BarLight & "'/>
			  <text x='" & LYx + BarW/2 & "' y='" & BarBottom + 16 & "' font-size='9' fill='" & Muted & "' text-anchor='middle'>LY</text>
			
			  <!-- Diff bar -->
			  <text x='" & Diffx + BarW/2 & "' y='" & Diffy - 8 & "' font-size='9' font-weight='bold' fill='" & YoYColor & "' text-anchor='middle'>" & DiffFmtK & "</text>
			  <rect x='" & Diffx & "' y='" & Diffy & "' width='" & BarW & "' height='" & DiffBarH & "' rx='3' fill='" & YoYColor & "'/>
			  <text x='" & Diffx + BarW/2 & "' y='" & BarBottom + 16 & "' font-size='9' fill='" & Muted & "' text-anchor='middle'>Δ</text>
			
			  <!-- TY bar -->
			  <text x='" & TYx + BarW/2 & "' y='" & TYy - 8 & "' font-size='9' fill='" & Muted & "' text-anchor='middle'>" & TYLabel & "</text>
			  <rect x='" & TYx & "' y='" & TYy & "' width='" & BarW & "' height='" & TYBarH & "' rx='3' fill='" & BarDark & "'/>
			  <text x='" & TYx + BarW/2 & "' y='" & BarBottom + 16 & "' font-size='9' fill='" & Muted & "' text-anchor='middle'>TY</text>
			
			</svg>"
			```
		lineageTag: d7c970d2-704b-49d6-8e51-d60d82b7c18f

	measure '7_SM Period Subtitle Combined' = ```
			
			VAR _Current = [4_SM Date Param]
			VAR _Past    = [4_SM Date Param Past Period]
			
			-- Format _Current
			VAR NumOfDigits_C =
			    IFERROR(LEN(CONVERT(INT(_Current), STRING)), 0)
			VAR Suffix_C =
			    ".00" &
			    SWITCH(
			        TRUE(),
			        NumOfDigits_C >= 13, "T",
			        NumOfDigits_C >= 10, "B",
			        NumOfDigits_C >= 7,  "M",
			        NumOfDigits_C >= 4,  "K"
			    )
			VAR Commas_C =
			    REPT(",",
			        SWITCH(
			            TRUE(),
			            NumOfDigits_C >= 13, "4",
			            NumOfDigits_C >= 10, "3",
			            NumOfDigits_C >= 7,  "2",
			            NumOfDigits_C >= 4,  "1"
			        )
			    )
			VAR _Format_C = "#,##0" & Commas_C & Suffix_C & ";-#,##0" & Commas_C & Suffix_C
			VAR CurrentFormatted = FORMAT(_Current, _Format_C)
			
			-- Format _Past
			VAR NumOfDigits_P =
			    IFERROR(LEN(CONVERT(INT(_Past), STRING)), 0)
			VAR Suffix_P =
			    ".00" &
			    SWITCH(
			        TRUE(),
			        NumOfDigits_P >= 13, "T",
			        NumOfDigits_P >= 10, "B",
			        NumOfDigits_P >= 7,  "M",
			        NumOfDigits_P >= 4,  "K"
			    )
			VAR Commas_P =
			    REPT(",",
			        SWITCH(
			            TRUE(),
			            NumOfDigits_P >= 13, "4",
			            NumOfDigits_P >= 10, "3",
			            NumOfDigits_P >= 7,  "2",
			            NumOfDigits_P >= 4,  "1"
			        )
			    )
			VAR _Format_P = "#,##0" & Commas_P & Suffix_P & ";-#,##0" & Commas_P & Suffix_P
			VAR PastFormatted = FORMAT(_Past, _Format_P)
			
			-- Labels
			VAR CurrentLabel = 
			    SWITCH([3_Selected Dates],
			        "1W", "Last 7 Days: ",
			        "1M", "Last 30 Days: ",
			        "3M", "Last 3 Months: ",
			        "TY", "Year to Date: ",
			        "1Y", "Trailing 12 Months: ",
			        "ALL","All Time: ")
			
			VAR PastLabel = 
			    SWITCH([3_Selected Dates],
			        "1W", "Previous 7-Day: ",
			        "1M", "Previous 30-Day: ",
			        "3M", "Previous 3-Month: ",
			        "TY", "Prior Year to Date: ",
			        "1Y", "Prior 12 Months: ",
			        "ALL","")
			
			VAR CurrentLine = CurrentLabel & CurrentFormatted
			VAR PastLine    = IF(PastLabel = "", "", PastLabel & PastFormatted)
			
			RETURN
			CurrentLine & IF(PastLine <> "", UNICHAR(10) & PastLine)
			```
		lineageTag: dac81f8e-3736-44dc-bdef-2cbabdb48438

	measure HTML_RevenueBridge1test = ```
			
			VAR MaxDate   = CALCULATE(MAX('Dim_Date'[CalendarDate]), ALL('Dim_Date'))
			VAR MinDate   = CALCULATE(MIN('Dim_Date'[CalendarDate]), ALL('Dim_Date'))
			
			VAR SelectedPeriod = SELECTEDVALUE('Date Selection'[Date Selection], "TY")
			
			VAR PeriodStart = [3_Selected Min Date]
			VAR PeriodEnd   = [2_MaxDate]
			VAR PeriodStartLY = DATE(YEAR(PeriodStart)-1, MONTH(PeriodStart), DAY(PeriodStart))
			VAR PeriodEndLY   = DATE(YEAR(PeriodEnd)-1, MONTH(PeriodEnd), DAY(PeriodEnd))
			
			-- Remove the Year slicer's filter on Dim_Date so PeriodStart/PeriodEnd fully control the window
			VAR ThisYear = 
			    CALCULATE(
			        [3_Selected Measure], 
			        KEEPFILTERS(DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStart, PeriodEnd)),
			        REMOVEFILTERS('Dim_Date'[Year])
			    )
			VAR LastYear = 
			    CALCULATE(
			        [3_Selected Measure], 
			        KEEPFILTERS(DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStartLY, PeriodEndLY)),
			        REMOVEFILTERS('Dim_Date'[Year])
			    )
			
			VAR YoYDiff = ThisYear - LastYear
			VAR YoYPct  = DIVIDE(YoYDiff, LastYear) * 100
			
			VAR Muted     = "#000000"
			VAR BarLight  = "#4a4a4a"
			VAR BarDark   = "#e5e5e5"
			VAR YoYColor  = IF(YoYPct >= 0, "#22c55e", "#ef4444")
			VAR YoYArrow  = IF(YoYPct >= 0, "▲", "▼")
			
			VAR DiffFmtK = IF(YoYDiff>=0,"+","-") & FORMAT(ABS(YoYDiff)/1000, "#,##0.0") & "K"
			VAR TYLabel = FORMAT(ThisYear/1000, "#,##0.0") & "K"
			VAR LYLabel = FORMAT(LastYear/1000, "#,##0.0") & "K"
			
			VAR BarTop    = 70
			VAR BarBottom = 175
			VAR BarAreaH  = BarBottom - BarTop
			VAR MaxVal    = MAX(ThisYear, LastYear)
			VAR LYBarH    = ROUND(BarAreaH * DIVIDE(LastYear, MaxVal), 1)
			VAR TYBarH    = ROUND(BarAreaH * DIVIDE(ThisYear, MaxVal), 1)
			VAR DiffBarH  = MAX(ABS(TYBarH - LYBarH), 8)
			VAR DiffBottomH = MIN(LYBarH, TYBarH)
			
			VAR LYy   = BarBottom - LYBarH
			VAR TYy   = BarBottom - TYBarH
			VAR Diffy = BarBottom - DiffBottomH - DiffBarH
			
			VAR BarW  = 44
			VAR LYx   = 20
			VAR Diffx = 88
			VAR TYx   = 156
			
			RETURN
			"<svg width='100%' height='100%' viewBox='0 0 220 220' preserveAspectRatio='xMidYMid meet' xmlns='http://www.w3.org/2000/svg' font-family='Arial'>
			
			  <text x='20' y='24' font-size='14' fill='" & Muted & "'>ΔLY</text>
			  <text x='55' y='24' font-size='16' font-weight='bold' fill='" & YoYColor & "'>" & FORMAT(YoYPct,"+0.0") & "% " & YoYArrow & "</text>
			
			  <text x='" & LYx + BarW/2 & "' y='" & LYy - 10 & "' font-size='13' fill='" & Muted & "' text-anchor='middle'>" & LYLabel & "</text>
			  <rect x='" & LYx & "' y='" & LYy & "' width='" & BarW & "' height='" & LYBarH & "' rx='4' fill='" & BarLight & "'/>
			  <text x='" & LYx + BarW/2 & "' y='" & BarBottom + 22 & "' font-size='14' font-weight='bold' fill='" & Muted & "' text-anchor='middle'>LY</text>
			
			  <text x='" & Diffx + BarW/2 & "' y='" & Diffy - 10 & "' font-size='13' font-weight='bold' fill='" & YoYColor & "' text-anchor='middle'>" & DiffFmtK & "</text>
			  <rect x='" & Diffx & "' y='" & Diffy & "' width='" & BarW & "' height='" & DiffBarH & "' rx='4' fill='" & YoYColor & "'/>
			  <text x='" & Diffx + BarW/2 & "' y='" & BarBottom + 22 & "' font-size='14' font-weight='bold' fill='" & Muted & "' text-anchor='middle'>Δ</text>
			
			  <text x='" & TYx + BarW/2 & "' y='" & TYy - 10 & "' font-size='13' fill='" & Muted & "' text-anchor='middle'>" & TYLabel & "</text>
			  <rect x='" & TYx & "' y='" & TYy & "' width='" & BarW & "' height='" & TYBarH & "' rx='4' fill='" & BarDark & "'/>
			  <text x='" & TYx + BarW/2 & "' y='" & BarBottom + 22 & "' font-size='14' font-weight='bold' fill='" & Muted & "' text-anchor='middle'>TY</text>
			
			</svg>"
			```
		lineageTag: 7cf6a0dd-74f0-4ca5-b74a-6c81a74b20e0

