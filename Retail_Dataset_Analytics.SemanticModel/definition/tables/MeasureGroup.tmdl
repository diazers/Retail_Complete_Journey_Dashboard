	measure 'Store Label' =
			
			VAR _Sales = [4_SM Date Param]
			VAR _SalesLY = [4_SM Date Param LY]
			VAR _YoY = DIVIDE ( _Sales - _SalesLY, _SalesLY )
			VAR _Arrow = IF ( _YoY >= 0, "▲", "▼" )
			VAR _SalesText = FORMAT ( _Sales, "#,0,""K""" )
			VAR _PctText = FORMAT ( ABS ( _YoY ), "0%" )
			RETURN
			IF (
			    ISBLANK ( _Sales ),
			    BLANK(),
			    IF (
			        ISBLANK ( _YoY ),
			        _SalesText,
			        _SalesText & " | " & _PctText & " " & _Arrow
			    )
			)
		lineageTag: ee35a800-c33c-446c-aa51-50bed96887cc

	measure 'Store Label Color' =
			
			VAR _Sales = [4_SM Date Param]
			VAR _SalesLY = [4_SM Date Param LY]
			VAR _YoY = DIVIDE ( _Sales - _SalesLY, _SalesLY )
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( _Sales ) || ISBLANK ( _YoY ), "#605E5C", -- Neutral grey for blank values
			    _YoY >= 0, "#1DB954",                              -- Green for positive growth (▲)
			    "#E74C3C"                                           -- Red for negative growth (▼)
			)
		lineageTag: 620d094d-d8c5-41bd-bf9c-ccc61a131a73

	measure Percentage = ```
			
			VAR PeriodStart   = [3_Selected Min Date]
			VAR PeriodEnd     = [2_MaxDate]
			
			VAR PeriodStartLY = EDATE(PeriodStart, -12)
			VAR PeriodEndLY   = EDATE(PeriodEnd, -12)
			
			VAR ThisYear = 
			    CALCULATE(
			        [3_Selected Measure], 
			        DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStart, PeriodEnd),
			        REMOVEFILTERS('Dim_Date')
			    )
			
			VAR LastYear = 
			    CALCULATE(
			        [3_Selected Measure], 
			        DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStartLY, PeriodEndLY),
			        REMOVEFILTERS('Dim_Date')
			    )
			
			VAR _Variance = ThisYear - LastYear
			VAR YoYPct    = DIVIDE(_Variance, LastYear)
			
			-- Dynamic K/M/B/T scaling for Variance
			VAR _ValForScaling = ABS(_Variance)
			VAR NumOfDigits    = IFERROR(LEN(CONVERT(INT(_ValForScaling), STRING)), 0)
			
			VAR Suffix =
			    ".0" &
			    SWITCH(
			        TRUE(),
			        NumOfDigits >= 13, "T",
			        NumOfDigits >= 10, "B",
			        NumOfDigits >= 7,  "M",
			        NumOfDigits >= 4,  "K",
			        ""
			    )
			
			VAR Commas =
			    REPT(",",
			        SWITCH(
			            TRUE(),
			            NumOfDigits >= 13, 4,
			            NumOfDigits >= 10, 3,
			            NumOfDigits >= 7,  2,
			            NumOfDigits >= 4,  1,
			            0
			        )
			    )
			
			VAR VarianceFormat = "#,##0" & Commas & Suffix & ";-#,##0" & Commas & Suffix & ";0.0"
			
			RETURN
			    IF(
			        ISBLANK(ThisYear) || ISBLANK(LastYear),
			        BLANK(),
			        FORMAT(_Variance, VarianceFormat) & FORMAT(YoYPct, " | 0.0% ▲; | 0.0% ▼; | 0.0%")
			    )
			```
		lineageTag: 4a9bd2e4-859c-4ea9-9ed0-d490bbab3b77

	measure '7_SM Reference Label Last Period' =
			
			VAR _Current  = [4_SM Date Param]
			VAR _PY       = [4_SM Date Param Past Period] -- Replace with [4_SM Date Param Past Period] if using original measure name
			VAR _Variance = _Current - _PY
			VAR _Growth   = DIVIDE(_Variance, _PY)
			
			-- Base dynamic scaling (K, M, B, T) on the Variance amount
			VAR _ValForScaling = ABS(_Variance)
			VAR NumOfDigits    = IFERROR(LEN(CONVERT(INT(_ValForScaling), STRING)), 0)
			
			VAR Suffix =
			    ".0" &
			    SWITCH(
			        TRUE(),
			        NumOfDigits >= 13, "T",
			        NumOfDigits >= 10, "B",
			        NumOfDigits >= 7,  "M",
			        NumOfDigits >= 4,  "K",
			        ""
			    )
			
			VAR Commas =
			    REPT(",",
			        SWITCH(
			            TRUE(),
			            NumOfDigits >= 13, 4,
			            NumOfDigits >= 10, 3,
			            NumOfDigits >= 7,  2,
			            NumOfDigits >= 4,  1,
			            0
			        )
			    )
			
			-- Format includes explicit '+' for positive growth (e.g., +1.5M | 12.0% ▲)
			VAR _Format = "+#,##0" & Commas & Suffix & ";-#,##0" & Commas & Suffix & ";0"
			
			RETURN
			IF(
			    NOT ISBLANK(_PY) && NOT ISBLANK(_Current),
			    FORMAT(_Variance, _Format) & FORMAT(_Growth, " | 0.0% ▲; | 0.0% ▼; | 0.0%"),
			    " "
			)
		lineageTag: bd3c96fc-e694-4e96-9c3c-2a34eef1f058

	measure 'Percentage YoY' = ```
			
			VAR PeriodStart   = [3_Selected Min Date]
			VAR PeriodEnd     = [2_MaxDate]
			
			-- Shift exact selected period back by 12 months (e.g., June 2026 -> June 2025)
			VAR PeriodStartLY = EDATE(PeriodStart, -12)
			VAR PeriodEndLY   = EDATE(PeriodEnd, -12)
			
			VAR CurrentPeriod = 
			    CALCULATE(
			        [3_Selected Measure], 
			        DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStart, PeriodEnd),
			        REMOVEFILTERS('Dim_Date')
			    )
			
			VAR PriorYearPeriod = 
			    CALCULATE(
			        [3_Selected Measure], 
			        DATESBETWEEN('Dim_Date'[CalendarDate], PeriodStartLY, PeriodEndLY),
			        REMOVEFILTERS('Dim_Date')
			    )
			
			VAR YoYPct = DIVIDE(CurrentPeriod - PriorYearPeriod, PriorYearPeriod)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(YoYPct), BLANK(),
			        YoYPct >= 0, "up " & FORMAT(YoYPct, "0.00%"),
			        YoYPct < 0,  "down " & FORMAT(ABS(YoYPct), "0.00%")
			    )
			```
		lineageTag: 8b5b2b54-92a3-4b71-bace-6f0846d76ba9

	measure 'Sales Bar' = ```
			
			VAR CurrentSales = [Total_Sales]
			VAR PriorSales = [Total_Sales LY]
			VAR MaxSales =
			    CALCULATE(
			        [Total_Sales],
			        ALL(hh_demographic)          -- clears ALL columns in the table, whichever one is active
			    )
			VAR BarWidth = DIVIDE(CurrentSales, MaxSales) * 300
			VAR MarkerX = DIVIDE(PriorSales, MaxSales) * 300
			VAR PctOfTotal =
			    DIVIDE(
			        CurrentSales,
			        CALCULATE([Total_Sales], ALL(hh_demographic))
			    )
			VAR BarColor = "#118DFF"
			RETURN
			    "data:image/svg+xml;utf8," &
			    "<svg xmlns='http://www.w3.org/2000/svg' width='420' height='24'>" &
			        "<rect x='0' y='2' width='" & BarWidth & "' height='20' fill='" & BarColor & "'/>" &
			        "<line x1='" & MarkerX & "' y1='0' x2='" & MarkerX & "' y2='24' stroke='#1A1A1A' stroke-width='2'/>" &
			        "<text x='" & (BarWidth + 8) & "' y='16' font-size='15' fill='#000000'>" &
			            FORMAT(CurrentSales, "#,##0") & " | " & FORMAT(PctOfTotal, "0%") &
			        "</text>" &
			    "</svg>"
			
			
