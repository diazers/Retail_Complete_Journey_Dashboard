table coupon_redempt
	lineageTag: b51e74d7-2ec8-4f27-8303-6b3965064d18

	measure 'Household Redemption Rate' = ```
			
			VAR HouseholdsTargeted = 
			    DISTINCTCOUNT(campaign_table[household_key])
			VAR HouseholdsRedeemed = 
			    DISTINCTCOUNT(coupon_redempt[household_key])
			RETURN
			    DIVIDE(HouseholdsRedeemed, HouseholdsTargeted)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9e945db2-2907-4b17-862b-839a44ba501c

	measure 'Coupon Redemption Rate' =
			
			VAR Total_Coupons_Available = DISTINCTCOUNT(coupon[COUPON_UPC])
			
			VAR Coupons_Redeemed = DISTINCTCOUNT(coupon_redempt[COUPON_UPC])
			
			RETURN
			    DIVIDE(Coupons_Redeemed, Total_Coupons_Available)
		lineageTag: c49fbdcc-6afc-4c6f-945c-63f1a32d10fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

