table Pareto1
	lineageTag: b5a8e55c-e5f1-4fd0-bd72-86503f5a8eb2

	measure '_1 Revenue' = [4_SM Date Param] / 1000000
		displayFolder: Department Pareto
		lineageTag: cb4b48cb-e7f8-4bb1-acd2-f7e159601af1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_1 Total Revenue' =
			
			CALCULATE (
			    [_1 Revenue],
			    ALLSELECTED ( Fact_Sales_GPMargin )
			)
		displayFolder: Department Pareto
		lineageTag: 33346d83-1421-420a-8820-0f524c37467a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_1 Rank' =
			
			IF (
			    ISINSCOPE ( Fact_Sales_GPMargin[DEPARTMENT] ),
			    RANKX (
			        ALLSELECTED ( Fact_Sales_GPMargin[DEPARTMENT] ),
			        [_1 Revenue]
			    )
			)
		formatString: 0
		displayFolder: Department Pareto
		lineageTag: 88e42bcd-1874-4f26-8619-b1079e88ea87

	measure '_1 Cumulative Revenue' =
			
			IF (
			    ISINSCOPE ( Fact_Sales_GPMargin[DEPARTMENT] ),
			    CALCULATE (
			        [_1 Revenue],
			        TOPN (
			            [_1 Rank],
			            ALLSELECTED ( Fact_Sales_GPMargin[DEPARTMENT] ),
			            [_1 Revenue]
			        )
			    ),
			    [_1 Total Revenue]
			)
		displayFolder: Department Pareto
		lineageTag: 7c2cd132-ca6f-4cb0-8c79-0fa849294073

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_1 Cumulative Revenue %' =
			
			DIVIDE (
			    [_1 Cumulative Revenue],
			    [_1 Total Revenue]
			)
		displayFolder: Department Pareto
		lineageTag: a7fd4c66-f74e-4b97-8461-ac2f64dd761b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_1 Cutoff Department' =
			
			VAR TargetPercentage = [Pareto Value]
			VAR ClosestDepartment =
			    TOPN (
			        1,
			        ADDCOLUMNS (
			            SUMMARIZE (
			                ALLSELECTED ( Fact_Sales_GPMargin ),
			                Fact_Sales_GPMargin[DEPARTMENT]
			            ),
			            "CumulativeRevenuePercent", [_1 Cumulative Revenue %],
			            "Difference", ABS ( [_1 Cumulative Revenue %] - TargetPercentage )
			        ),
			        [Difference], ASC
			    )
			RETURN
			    MAXX ( ClosestDepartment, Fact_Sales_GPMargin[DEPARTMENT] )
		displayFolder: Department Pareto
		lineageTag: 798e44b4-eeaa-4c87-9561-15b81c8aa486

	measure '_1 Cutoff Rank' =
			
			VAR ClosestDepartment = [_1 Cutoff Department]
			RETURN
			IF (
			    SELECTEDVALUE ( Fact_Sales_GPMargin[DEPARTMENT] ) = ClosestDepartment,
			    [_1 Rank],
			    BLANK ()
			)
		formatString: 0
		displayFolder: Department Pareto
		lineageTag: bbacc494-5de5-4a21-9e12-2c3f383b82fa

	measure '_4 Pareto Cutoff Rank' =
			
			CALCULATE (
			    MAXX ( VALUES ( Fact_Sales_GPMargin[DEPARTMENT] ), [_1 Cutoff Rank] ),
			    ALLSELECTED ( Fact_Sales_GPMargin )
			)
		formatString: 0
		displayFolder: Department Pareto
		lineageTag: 35070cc3-39f2-43c2-8c9e-4fe457b67488

	measure '_1 Color' =
			
			IF ( [_1 Rank] > [_4 Pareto Cutoff Rank], "#FFC399", "#FF6900" )
		displayFolder: Department Pareto
		lineageTag: e814994a-cc7f-4e8c-bc9f-8e1d861827dd

	measure '__1 Vertical Pareto Chart' =
			
			VAR _CellHeight = 30
			VAR _MarkerY    = _CellHeight / 2
			
			VAR _MarkerSize         = 4
			VAR _CutoffOuterSize    = 8
			VAR _CutoffInnerSize    = 4
			
			VAR _BarY = 8
			VAR _BarHeight = _CellHeight * 0.7
			VAR _BarRoundness = 3
			
			VAR _Actual = [_1 Revenue]
			VAR _Target = [_1 Cumulative Revenue %] * 0.8
			
			VAR _BarMax = 200
			VAR _BarMin = 0
			VAR _Scope = ALLSELECTED ( Fact_Sales_GPMargin[DEPARTMENT] )
			
			VAR _BackgroundColor = "#F5F5F500"
			VAR _BaselineColor   = "grey"
			VAR _TargetColor     = "#12239E"
			VAR _BarFillColor    = [_1 Color]
			VAR _BarBorderColor  = "#605E5C"
			
			VAR _MaxActualsInScope =
			    CALCULATE ( MAXX ( _Scope, [_1 Revenue] ), REMOVEFILTERS ( Fact_Sales_GPMargin[DEPARTMENT] ) )
			VAR _MaxTargetInScope =
			    CALCULATE ( MAXX ( _Scope, [_1 Cumulative Revenue %] ), REMOVEFILTERS ( Fact_Sales_GPMargin[DEPARTMENT] ) )
			VAR _AxisMax = MAX ( _MaxActualsInScope, _MaxTargetInScope )
			
			VAR _AxisRange        = _BarMax - _BarMin
			VAR _ActualNormalized = DIVIDE ( _Actual, _AxisMax ) * _AxisRange
			VAR _TargetNormalized = ( DIVIDE ( _Target, _AxisMax ) * _AxisRange ) + _BarMin - 1
			
			VAR _CurrentRank = [_1 Rank]
			VAR _CutoffRank  = [_4 Pareto Cutoff Rank]
			
			VAR _Table =
			    SUMMARIZE (
			        ALLSELECTED ( Fact_Sales_GPMargin[DEPARTMENT] ),
			        Fact_Sales_GPMargin[DEPARTMENT],
			        "RankValue", [_1 Rank],
			        "TargetVal", [_1 Cumulative Revenue %] * 0.8
			    )
			
			VAR _PrevTarget =
			    IF (
			        _CurrentRank > 1,
			        MAXX ( FILTER ( _Table, [RankValue] = _CurrentRank - 1 ), [TargetVal] )
			    )
			VAR _PrevTargetNormalized =
			    IF ( NOT ISBLANK ( _PrevTarget ), DIVIDE ( _PrevTarget, _AxisMax ) * _AxisRange + _BarMin - 1 )
			
			VAR _NextTarget =
			    MAXX ( FILTER ( _Table, [RankValue] = _CurrentRank + 1 ), [TargetVal] )
			VAR _NextTargetNormalized =
			    IF ( NOT ISBLANK ( _NextTarget ), DIVIDE ( _NextTarget, _AxisMax ) * _AxisRange + _BarMin - 1 )
			
			VAR _PrevMarkerY = _MarkerY - _CellHeight
			VAR _NextMarkerY = _MarkerY + _CellHeight
			
			VAR _ConnectingLineUp =
			    IF (
			        _CurrentRank > 1 && NOT ISBLANK ( _PrevTargetNormalized ),
			        "<polyline points='" & _PrevTargetNormalized & "," & _PrevMarkerY & " " & _TargetNormalized & "," & _MarkerY & "' fill='none' stroke='" & _TargetColor & "' stroke-width='2' />",
			        ""
			    )
			
			VAR _ConnectingLineDown =
			    IF (
			        NOT ISBLANK ( _NextTargetNormalized ),
			        "<polyline points='" & _TargetNormalized & "," & _MarkerY & " " & _NextTargetNormalized & "," & _NextMarkerY & "' fill='none' stroke='" & _TargetColor & "' stroke-width='2' />",
			        ""
			    )
			
			VAR _ActualBarPath =
			    "M " & _BarMin & " " & _BarY &
			    " L " & ( _BarMin + _ActualNormalized - _BarRoundness ) & " " & _BarY &
			    " A " & _BarRoundness & " " & _BarRoundness & " 0 0 1 " & ( _BarMin + _ActualNormalized ) & " " & ( _BarY + _BarRoundness ) &
			    " L " & ( _BarMin + _ActualNormalized ) & " " & ( _BarY + _BarHeight - _BarRoundness ) &
			    " A " & _BarRoundness & " " & _BarRoundness & " 0 0 1 " & ( _BarMin + _ActualNormalized - _BarRoundness ) & " " & ( _BarY + _BarHeight ) &
			    " L " & _BarMin & " " & ( _BarY + _BarHeight ) &
			    " Z"
			
			VAR _NormalCircle =
			    "<circle cx='" & _TargetNormalized & "' cy='" & _MarkerY & "' r='" & _MarkerSize & "' fill='" & _TargetColor & "'/>"
			
			VAR _CutoffCircle =
			    "<circle cx='" & _TargetNormalized & "' cy='" & _MarkerY & "' r='" & _CutoffOuterSize & "' fill='" & _TargetColor & "'/>" &
			    "<circle cx='" & _TargetNormalized & "' cy='" & _MarkerY & "' r='" & _CutoffInnerSize & "' fill='white'/>"
			
			VAR _MarkerCircle =
			    IF ( _CurrentRank = _CutoffRank, _CutoffCircle, _NormalCircle )
			
			VAR _YMin = 0
			VAR _ViewBoxHeight = _CellHeight
			
			VAR _SvgPrefix =
			    "data:image/svg+xml;utf8, <svg xmlns='http://www.w3.org/2000/svg' width='" & _BarMax & "' height='30' viewBox='0 " & _YMin & " " & _BarMax & " " & _ViewBoxHeight & "' preserveAspectRatio='none' overflow='visible'>"
			
			VAR _Sort = "<desc>" & FORMAT ( _Actual, "000000000000" ) & "</desc>"
			VAR _BarBaseline = "<rect x='" & _BarMin & "' y='0' width='1' height='100%' fill='" & _BaselineColor & "'/>"
			VAR _BarBackground = "<rect x='" & _BarMin & "' y='2' width='" & _BarMax & "' height='80%' fill='" & _BackgroundColor & "'/>"
			VAR _ActualBar = "<path d='" & _ActualBarPath & "' fill='" & _BarFillColor & "' stroke='" & _BarBorderColor & "' stroke-width='1'/>"
			VAR _SvgSuffix = "</svg>"
			
			VAR _SVG =
			    _SvgPrefix & _Sort & _BarBackground & _ActualBar & _BarBaseline &
			    _ConnectingLineUp & _ConnectingLineDown & _MarkerCircle & _SvgSuffix
			
			RETURN
			    IF ( ISINSCOPE ( Fact_Sales_GPMargin[DEPARTMENT] ), _SVG )
		displayFolder: Department Pareto
		lineageTag: b74c4134-7394-479a-8720-68da79b28165
		dataCategory: ImageUrl

	measure '_1 Store Revenue' = SUM ( Fact_Sales_GPMargin[SALES_VALUE] ) / 1000000
