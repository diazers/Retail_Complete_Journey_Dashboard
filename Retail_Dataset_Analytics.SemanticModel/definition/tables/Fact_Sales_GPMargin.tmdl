	column Hour
		dataType: int64
		formatString: 0
		lineageTag: 5bf40a19-728f-4949-a62a-552a5695b8f4
		summarizeBy: sum
		sourceColumn: Hour

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column 'Is Redeemed Line' =
			
			IF(
			    Fact_Sales_GPMargin[COUPON_DISC] <> 0 || Fact_Sales_GPMargin[COUPON_MATCH_DISC] <> 0,
			    TRUE, FALSE
			)
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 0dac7977-adce-4a88-a55c-0c89d7972651
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Has Causal Match' = NOT ISBLANK(RELATED(Dim_Causal[CausalKey]))
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1d460c65-d1c8-4fc0-b5f9-66a002497be7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Retail Discount Band' = ```
			
			VAR TotalDisc = 
			    Fact_Sales_GPMargin[RETAIL_DISC] 
			    + Fact_Sales_GPMargin[COUPON_DISC] 
			    + Fact_Sales_GPMargin[COUPON_MATCH_DISC]
			RETURN
			SWITCH(
			    TRUE(),
			    TotalDisc = 0, "No Discount",
			    TotalDisc > 0, "Positive (Data Check)",
			    TotalDisc >= -1, "Small (up to $1)",
			    TotalDisc >= -5, "Moderate ($1-$5)",
			    TotalDisc >= -20, "Large ($5-$20)",
			    "Very Large ($20+)"
			)
			```
		lineageTag: 4fd6454e-58e5-499f-b522-c16e20eeb694
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'List Price' = ```
			
			Fact_Sales_GPMargin[SALES_VALUE] 
			    - Fact_Sales_GPMargin[RETAIL_DISC] 
			    - Fact_Sales_GPMargin[COUPON_DISC] 
			    - Fact_Sales_GPMargin[COUPON_MATCH_DISC]
			```
		lineageTag: c500317a-1e5a-4336-bdd0-f6b98ca7ff81
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Retail Discount Band Sort' = ```
			
			VAR TotalDisc = 
			    Fact_Sales_GPMargin[RETAIL_DISC] 
			    + Fact_Sales_GPMargin[COUPON_DISC] 
			    + Fact_Sales_GPMargin[COUPON_MATCH_DISC]
			RETURN
			SWITCH(
			    TRUE(),
			    TotalDisc > 0, 0,
			    TotalDisc = 0, 1,
			    TotalDisc >= -1, 2,
			    TotalDisc >= -5, 3,
			    TotalDisc >= -20, 4,
			    5
			)
			```
		formatString: 0
		lineageTag: 10a2aa81-dd4c-4b1d-a48d-4b0d48a22c03
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Estimated_COGS = Fact_Sales_GPMargin[List Price] * ( 1 - Fact_Sales_GPMargin[AssumedMargin] )
		lineageTag: 762ce1c6-5f4d-4b95-9d69-31b681e7315c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Estimated_Gross_Profit = Fact_Sales_GPMargin[SALES_VALUE] - Fact_Sales_GPMargin[Estimated_COGS]
		lineageTag: 164c582f-271a-4ed7-8cd5-313c1a3d1188
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

