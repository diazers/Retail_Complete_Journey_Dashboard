table Dim_Causal
	lineageTag: 713ff4a9-d09b-42b4-b8a4-7a43fbdd89ff

	measure 'Redeemed Purchases by Display' =
			
			CALCULATE(
			    COUNTROWS(Fact_Sales_GPMargin),
			    Fact_Sales_GPMargin[Is Redeemed Line] = TRUE,
			    Fact_Sales_GPMargin[Has Causal Match] = TRUE
			)
		formatString: 0
		lineageTag: ff11fabe-1893-4855-bc14-99a5ee91fc2c

	measure 'Households Contributing' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Sales_GPMargin[HOUSEHOLD_KEY]),
			    Fact_Sales_GPMargin[Is Redeemed Line] = TRUE,
			    Fact_Sales_GPMargin[Has Causal Match] = TRUE
			)
		formatString: 0
		lineageTag: 686db461-8ef9-4137-a834-4358a4787032

	measure '% of Total Redeemed' =
			
			DIVIDE(
			    [Redeemed Value ($)],
			    CALCULATE(
			        [Redeemed Value ($)],
			        ALL('Aisle Mapping'[Display Code]),
			        'Aisle Mapping'[Display Code] <> BLANK()
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: aa3596d5-8a35-4593-94de-ccf1f90393e6

	column PRODUCT_ID
		dataType: int64
		formatString: 0
		lineageTag: 1c917793-1190-44b3-817a-6701126e70ca
		summarizeBy: count
		sourceColumn: PRODUCT_ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column STORE_ID
