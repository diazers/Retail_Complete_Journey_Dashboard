	column 'Lift Differential' = campaign_level_results2[REDEEMER_DID] - campaign_level_results2[NONREDEEMER_DID]
		lineageTag: 92c61de6-d2aa-4de7-96b1-20e8a8daaab5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Flag Direction' = IF( 'Campaign_Level_Results2'[REDEEMER_DID] < 0, "❌", "✅")
		lineageTag: 262ba82e-25a9-42ae-9859-8512e6af3401
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag Reliable' = IF( 'Campaign_Level_Results2'[REDEEMER_COUNT] >= 15, "✅", "❌" )
		lineageTag: f3638e90-182c-475d-8855-95b6b61e3561
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag Payback' = IF( 'Campaign_Level_Results2'[REDEEMER_RETURN_PER_DOLLAR] >= 1, "✅", "❌" )
		lineageTag: 94b9e9a8-c3dc-4bbf-a70e-9821a5c56dc8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Flag Attribution' = IF( 'Campaign_Level_Results2'[REDEEMER_DID] > 'Campaign_Level_Results2'[NONREDEEMER_DID], "✅", "❌" )
		lineageTag: 61526cab-ff61-4207-b2b7-8daefb19d813
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '% of Discount Spent on Non-Redeemers' =
			
			DIVIDE(
			    ABS( campaign_level_results2[NONREDEEMER_DISCOUNT] ),
			    ABS( campaign_level_results2[REDEEMER_DISCOUNT] ) + ABS( campaign_level_results2[NONREDEEMER_DISCOUNT] )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fc120a37-19d7-4db0-9146-9550b739dfff
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Net Result' = campaign_level_results2[REDEEMER_TOTAL_LIFT] - ABS(campaign_level_results2[REDEEMER_DISCOUNT])
		lineageTag: 95430700-15fe-49e2-a318-f4d5f60a664c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Quadrant =
			
			SWITCH( TRUE(),
			    campaign_level_results2[REDEEMER_DID] > 0 && campaign_level_results2[NONREDEEMER_DID] < 0, "Attributable Pattern",
			    campaign_level_results2[REDEEMER_DID] > 0 && campaign_level_results2[NONREDEEMER_DID] >= 0, "Broad Movement",
			    campaign_level_results2[REDEEMER_DID] <= 0 && campaign_level_results2[NONREDEEMER_DID] > 0, "Broad Decline",
			    "Backfire Pattern"
			)
		lineageTag: 1f05d065-55b5-4b8c-890c-35d3a89ab1a5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

