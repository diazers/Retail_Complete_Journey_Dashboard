table campaign_level_results2
	lineageTag: b76d7dc6-95fa-4a4c-939e-337fb6efa4b3

	measure 'Campaigns Passing All 3' =
			
			COUNTROWS( FILTER( campaign_level_results2, campaign_level_results2[Flag Direction] = "✅" && campaign_level_results2[Flag Reliable] = "✅" && campaign_level_results2[Flag Payback] = "✅" ) )
		formatString: 0
		lineageTag: d9f66cc3-b350-4ffb-9277-7879efb88344

	measure 'Passing Direction Summary' = ```
			
			VAR TotalPass = CALCULATE( COUNTROWS( campaign_level_results2 ), campaign_level_results2[Flag Direction] = "✅", ALL( campaign_level_results2[Flag Direction] ) )
			VAR TotalFail = CALCULATE( COUNTROWS( campaign_level_results2 ), campaign_level_results2[Flag Direction] = "❌", ALL( campaign_level_results2[Flag Direction] ) )
			
			-- Check what is currently selected in the slicer
			VAR CurrentSelection = VALUES( campaign_level_results2[Flag Direction] )
			VAR IsPassSelected = "✅" IN CurrentSelection && NOT("❌" IN CurrentSelection)
			VAR IsFailSelected = "❌" IN CurrentSelection && NOT("✅" IN CurrentSelection)
			
			VAR PassDisplay = IF( IsFailSelected, "--", TotalPass )
			VAR FailDisplay = IF( IsPassSelected, "--", TotalFail )
			
			RETURN
			"✅ " & PassDisplay & "   ❌ " & FailDisplay
			
			
			
			// Passing Direction Summary = 
			// VAR PassCount = COUNTROWS( FILTER( campaign_level_results2, campaign_level_results2[Flag Direction] = "✅" ) )
			// VAR FailCount = COUNTROWS( FILTER( campaign_level_results2, campaign_level_results2[Flag Direction] = "❌" ) )
			// RETURN
			// "✅ " & PassCount & "   ❌ " & FailCount
			```
		lineageTag: b24c4f7a-02db-4269-acbd-0199fe5a608f

