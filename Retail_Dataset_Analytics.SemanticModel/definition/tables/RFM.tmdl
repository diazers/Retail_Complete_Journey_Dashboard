			)
		lineageTag: a8d02933-4c24-4c42-908b-a1c866c08ce5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_06PY Customer Count by Segment PY' =
			
			SUMX(
			    VALUES( 'RFM Segments'[Segment] ),
			    VAR CurrentSegment = 'RFM Segments'[Segment]
			    RETURN
			        CALCULATE(
			            DISTINCTCOUNT( hh_demographic[household_key] ),
			            FILTER( hh_demographic, [_05 RFM Customer Segment] = CurrentSegment ),
			            DATEADD( Dim_Date[CalendarDate], -1, YEAR )
			        )
			)
		formatString: 0
		displayFolder: _04 △PY%
		lineageTag: 169e2d34-c01a-4fbe-a0af-fce9253e0460

	measure '_09PY Avg Monetary per Customer PY' =
			
			DIVIDE( [_08 Monetary by Segment PY], [_06PY Customer Count by Segment PY] )
		displayFolder: _04 △PY%
		lineageTag: 6d0f3d59-e127-4459-ab60-fbb6157550f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_RFM Selected Current' =
			
			VAR M = SELECTEDVALUE( 'RFM Metric Selector'[MetricName] )
			RETURN
			SWITCH( M,
			    "Customer Count", [_06 Customer Count by Segment],
			    "Avg Monetary per Customer", [_09 Avg Monetary per Customer],
			    "Monetary by Segment", [_08 Monetary by Segment],
			    BLANK()
			)
		lineageTag: 9c8fd367-7d44-4946-bdcc-49b02a964888

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_RFM Selected PY' =
			
			VAR M = SELECTEDVALUE( 'RFM Metric Selector'[MetricName] )
			RETURN
			SWITCH( M,
			    "Customer Count", [_06 Customer Count by Segment PY],
			    "Avg Monetary per Customer", [_09PY Avg Monetary per Customer PY],
			    "Monetary by Segment", [_08 Monetary by Segment PY],
			    BLANK()
			)
		lineageTag: 37d7c7ad-03a9-4f60-8f69-81ec9bb0afc5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

