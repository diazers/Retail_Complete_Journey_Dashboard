table RFM
	lineageTag: 336fc035-f968-40f1-985d-643a01136c05

	measure '_01 AC_Recency' =
			
			IF (
			    NOT ISINSCOPE ( hh_demographic[household_key]),
			    BLANK (),
			    VAR _AsOfDate =
			        MAX ( Dim_Date[CalendarDate] )
			    VAR _LastOrderDate =
			        CALCULATE (
			            MAX ( Fact_Sales_GPMargin[CalendarDate] ),
			            FILTER (
			                ALL ( Dim_Date[CalendarDate] ),
			                Dim_Date[CalendarDate] <= _AsOfDate
			            )
			        )
			    RETURN
			        DATEDIFF ( _LastOrderDate, _AsOfDate, DAY )
			)
		displayFolder: _01 AC
		lineageTag: 8799f651-1974-4f69-a90d-d0ed5fc17da1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01 AC_Frequency' =
			
			VAR _AsOfDate =
			    MAX ( Dim_Date[CalendarDate] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( Fact_Sales_GPMargin[BASKET_ID] ),
			    FILTER (
			        ALL ( Dim_Date[CalendarDate] ),
			        Dim_Date[CalendarDate] <= _AsOfDate
			    )
			)
		displayFolder: _01 AC
		lineageTag: 16bc0ae0-d6a6-4334-bf06-e3f0f4c59a72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01 AC_Monetary' =
			
			VAR _AsOfDate =
			    MAX ( Dim_Date[CalendarDate] )
			RETURN
			CALCULATE (
			    SUM ( Fact_Sales_GPMargin[SALES_VALUE] ),
			    FILTER (
			        ALL ( Dim_Date[CalendarDate] ),
			        Dim_Date[CalendarDate] <= _AsOfDate
			    )
			)
		displayFolder: _01 AC
		lineageTag: 5b12be7f-aa5f-483c-8ed3-158a3c059d82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01 R Score' = ```
			
			SWITCH ( TRUE(),
			    [_01 AC_Recency] <= 1,   5,
			    [_01 AC_Recency] <= 3,   4,
			    [_01 AC_Recency] <= 6,   3,
			    [_01 AC_Recency] <= 12,  2,
			    [_01 AC_Recency] > 12,   1
			)
			
			
			// SWITCH(
			//     TRUE(),
			//     [_01 AC_Recency] <= 200, 5,  
			//     [_01 AC_Recency] <= 400, 4,  
			//     [_01 AC_Recency] <= 600, 3,  
			//     [_01 AC_Recency] <= 800, 2,  
			//     [_01 AC_Recency] > 800, 1  
			// )
			```
		formatString: 0
		displayFolder: RFM Score
		lineageTag: 67c3d39a-cb27-41c1-b26d-18f84c9af7cb

	measure '_02 F Score' =
			
			SWITCH ( TRUE(),
			    [_01 AC_Frequency] <= 89,   1,
			    [_01 AC_Frequency] <= 122,  2,
			    [_01 AC_Frequency] <= 163,  3,
			    [_01 AC_Frequency] <= 233,  4,
			    [_01 AC_Frequency] > 233,   5
			)
		formatString: 0
		displayFolder: RFM Score
		lineageTag: a88ee62d-2e74-4712-be9c-f26daf26869f

	measure '_03 M Score' =
			
			SWITCH ( TRUE(),
			    [_01 AC_Monetary] <= 2640.01,  1,
			    [_01 AC_Monetary] <= 3871.04,  2,
			    [_01 AC_Monetary] <= 5532.21,  3,
			    [_01 AC_Monetary] <= 8131.91,  4,
			    [_01 AC_Monetary] > 8131.91,   5
			)
		formatString: 0
		displayFolder: RFM Score
		lineageTag: 10ed2a13-8630-4ed4-8296-bfc70a922253

	measure '_04 RFM Score' =
			
			CONCATENATE(
			    CONCATENATE( [_01 R Score], [_02 F Score] ),
			    [_03 M Score]
			)
		displayFolder: RFM Score
		lineageTag: 78b73db5-283c-4c25-80a5-c0ca56e7305d

	measure '_05 RFM Customer Segment' =
			
			IF(
			    ISINSCOPE( hh_demographic[household_key] ),
			    VAR RFM = [_04 RFM Score]
			    RETURN
			    SWITCH(
			        TRUE(),
			        RFM IN { "555", "554", "544", "545", "454", "455", "445" }, "Champions",
			        RFM IN { "543", "444", "435", "355", "354", "345", "344", "335" }, "Loyal",
			        RFM IN { "553", "551", "552", "541", "542", "533", "532", "531", "452", "451", "442", "441", "431", "453", "433", "432", "423", "353", "352", "351", "342", "341", "333", "323" }, "Potential Loyalist",
			        RFM IN { "512", "511", "422", "421", "412", "411", "311" }, "New Customers",
			        RFM IN { "525", "524", "523", "522", "521", "515", "514", "513", "425", "424", "413", "414", "415", "315", "314", "313" }, "Promising",
			        RFM IN { "535", "534", "443", "434", "343", "334", "325", "324" }, "Need Attention",
			        RFM IN { "331", "321", "312", "221", "213", "231", "241", "251" }, "About to Sleep",
			        RFM IN { "155", "154", "144", "214", "215", "115", "114", "113" }, "Cannot Lose Them but Losing",
			        RFM IN { "255", "254", "245", "244", "253", "252", "243", "242", "235", "234", "225", "224", "153", "152", "145", "143", "142", "135", "134", "133", "125", "124" }, "At Risk",
			        RFM IN { "332", "322", "233", "232", "223", "222", "132", "123", "122", "212", "211" }, "Hibernating Customers",
			        RFM IN { "111", "112", "121", "131", "141", "151" }, "Lost Customers",
			        "Other"
			    ),
			    BLANK() // Returns blank for totals
			)
		lineageTag: 5fd71c90-198a-4a88-a11b-35ff361d5adf

