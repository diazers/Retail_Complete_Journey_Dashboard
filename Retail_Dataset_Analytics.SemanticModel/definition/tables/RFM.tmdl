	measure '_00 Customer Names & Totals' =
			
			VAR _IsRow =
			    ISINSCOPE ( hh_demographic[household_key] )
			
			VAR _HasAC =
			    NOT (
			        ISBLANK ( [_01 AC_Frequency] )
			            && ISBLANK ( [_01 AC_Monetary] )
			            && ISBLANK ( [_01 AC_Recency] )
			    )
			
			VAR _HasPY =
			    NOT (
			        ISBLANK ( [_02 PY_Frequency] )
			            && ISBLANK ( [_02 PY_Monetary] )
			            && ISBLANK ( [_02 PY_Recency] )
			    )
			
			RETURN
			IF (
			    _IsRow,
			    IF (
			        _HasAC || _HasPY,
			        SELECTEDVALUE ( hh_demographic[household_key] ),
			        BLANK()
			    ),
			    "PY "
			        & FORMAT ( [_00 PY_Customers] + 0, "# ##0" )
			        & " AC "
			        & FORMAT ( [_00 AC_Customers] + 0, "# ##0" )
			)
		lineageTag: edebaf42-bd6c-4fcc-af10-f38b40dc3fa6

		formatStringDefinition = ""

	measure '_00 AC_Customers' =
			
			DISTINCTCOUNT ( hh_demographic[household_key] )
		formatString: 0
		lineageTag: 28427486-0b00-4f30-b8c1-bf635e62c2e2

	measure '_00 PY_Customers' =
			
			VAR _SelectedYear =
			    SELECTEDVALUE ( Dim_Date[CalendarDate] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( hh_demographic[household_key] ),
			    REMOVEFILTERS ( Dim_Date ),
			    Dim_Date[Year] = _SelectedYear - 1
			)
		formatString: 0
		displayFolder: RFM Score
		lineageTag: baaa7ee3-b054-43e6-a32e-c8f20e2644cc

	measure '_06 RFM Segment Sort Order' =
			
			IF(
			    ISINSCOPE( hh_demographic[household_key] ),
			    VAR Segment = [_05 RFM Customer Segment]
			    RETURN
			    SWITCH(
			        Segment,
			        "Champions", 1,
			        "Loyal", 2,
			        "Potential Loyalist", 3,
			        "New Customers", 4,
			        "Promising", 5,
			        "Need Attention", 6,
			        "About to Sleep", 7,
			        "Cannot Lose Them but Losing", 8,
			        "At Risk", 9,
			        "Hibernating Customers", 10,
			        "Lost Customers", 11,
			        "Other", 999,
			        BLANK()
			    ),
			    BLANK()
			)
		formatString: 0
		lineageTag: c83cea26-7989-4cdf-a9d6-bfbc2153e5f3

	measure '_06 Customer Count by Segment' = ```
			
			SUMX(
			    VALUES( 'RFM Segments'[Segment] ),
			    VAR CurrentSegment = 'RFM Segments'[Segment]
			    RETURN
			        CALCULATE(
			            DISTINCTCOUNT( hh_demographic[household_key] ),
			            FILTER( hh_demographic, [_05 RFM Customer Segment] = CurrentSegment )
			        )
			)
			
			// _06 Customer Count by Segment = 
			// VAR CurrentSegment = SELECTEDVALUE('RFM Segments'[Segment])
			// RETURN
			// CALCULATE(
			//     DISTINCTCOUNT(hh_demographic[household_key]),
			//     FILTER(
			//         hh_demographic,
			//         [_05 RFM Customer Segment] = CurrentSegment
			//     )
			// )
			
			
			
			```
		formatString: 0
		lineageTag: 1c5ca53c-9987-40fe-b4bf-8c808d237d31

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '_07 Is Selected Segment' =
			
			VAR SelectedSeg = SELECTEDVALUE( 'RFM Segments'[Segment] )
			RETURN
			IF(
			    ISBLANK( SelectedSeg ),
			    1,                                        -- nothing clicked yet, show all rows
			    IF( [_05 RFM Customer Segment] = SelectedSeg, 1, 0 )
			)
		formatString: 0
		lineageTag: 48160e64-3871-4226-ab8d-331b87ae1854

	measure '_08 Monetary by Segment' = ```
			
			SUMX(
			    VALUES( 'RFM Segments'[Segment] ),
			    VAR CurrentSegment = 'RFM Segments'[Segment]
			    RETURN
			        CALCULATE(
			            [_01 AC_Monetary],
			            FILTER( hh_demographic, [_05 RFM Customer Segment] = CurrentSegment )
			        )
			)
			
			// _08 Monetary by Segment = 
			// VAR CurrentSegment = SELECTEDVALUE( 'RFM Segments'[Segment] )
			// RETURN
			// CALCULATE(
			//     [_01 AC_Monetary],
			//     FILTER(
			//         hh_demographic,
			//         [_05 RFM Customer Segment] = CurrentSegment
			//     )
			// )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2af5d01b-3374-41b0-855b-74be248a1e0f

	measure '_09 Avg Monetary per Customer' =
			
			DIVIDE( [_08 Monetary by Segment], [_06 Customer Count by Segment] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 97449eb1-d4a4-48e1-a387-7b1d7eaee38b

	measure '_10 Monetary % of Total' = ```
			
			VAR TotalMonetary =
			    SUMX( ALL( 'RFM Segments'[Segment] ), [_08 Monetary by Segment] )
			RETURN
			DIVIDE( [_08 Monetary by Segment], TotalMonetary )
			
			
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: 3e57bcd3-a898-4079-8e53-62e661d62976

	measure '_08 Monetary by Segment PY' =
			
			CALCULATE(
			    [_08 Monetary by Segment],
			    DATEADD( Dim_Date[CalendarDate], -1, YEAR )
			)
		lineageTag: ed3acc17-27d2-4f86-8ae2-1e3e84e17282

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_16 Monetary AC vs PY Bar' =
			
			IF(
			    HASONEVALUE( 'RFM Segments'[Segment] ),
			    VAR AC = [_08 Monetary by Segment]
			    VAR PY = [_08 Monetary by Segment PY]
			    VAR MaxVal =
			        MAXX(
			            ALL( 'RFM Segments'[Segment] ),
			            VAR a = [_08 Monetary by Segment]
			            VAR p = [_08 Monetary by Segment PY]
			            RETURN MAX( a, p )
			        )
			    VAR AcPct = INT( DIVIDE( AC, MaxVal ) * 100 )
			    VAR PyPct = INT( DIVIDE( PY, MaxVal ) * 98 )
			    VAR PyMarker =
			        IF(
			            ISBLANK( PY ),
			            "",
			            "<rect x='" & PyPct & "%' y='0' width='2' height='20' fill='%23333333'/>"
			        )
			    RETURN
			        "data:image/svg+xml;utf8," &
			        "<svg xmlns='http://www.w3.org/2000/svg' width='100%' height='20'>" &
			        "<rect x='0' y='3' width='" & AcPct & "%' height='14' fill='%23118DFF'/>" &
			        PyMarker &
			        "</svg>"
			)
		lineageTag: 8ec205ac-8abb-4bd1-992f-1a1136f3460b
		dataCategory: ImageUrl

	measure '_06 Customer Count by Segment PY' =
			
			CALCULATE(
			    [_06 Customer Count by Segment],
			    DATEADD( Dim_Date[CalendarDate], -1, YEAR )
			)
		formatString: 0
