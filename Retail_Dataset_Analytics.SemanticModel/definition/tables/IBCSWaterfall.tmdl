	measure '_01F Q-M/△PY% (Formatted Label)' = [_01A Q-M/△PY%_Pin] * 100
		formatString: " +0""%"";-0""%"";0""%"""
		displayFolder: Upper Tier
		lineageTag: acc317dd-7f59-44f7-a80c-e8d9f301c983

		annotation PBI_FormatHint = {"isCustom":true}

	measure '_01G Total △PY%_Pin' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE( Table_Waterfall[Category 1] ),
			        SELECTEDVALUE( Table_Waterfall[Category 2] )  // Month hierarchy
			    )
			RETURN
			IF(
			    CategoryValue = "Total YoY",
			    CALCULATE( [_04 △PY% Net Sales], Dim_Date[Year] = SelectedYear ),
			    BLANK()
			)
			```
		displayFolder: Upper Tier
		lineageTag: 92a9473a-acc8-48d6-b87c-00ce64dfdd29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01H (+) Total △PY%_Pin (Capped Pin)' =
			
			VAR ValuePY = [_01G Total △PY%_Pin]
			VAR CappedValue =
			    MIN(1, MAX(-1, ValuePY))
			
			RETURN
			IF(
			    CappedValue > 0,
			    CappedValue
			)
		displayFolder: Upper Tier
		lineageTag: 95bdbfce-c342-4d7b-a64a-528f92a4eeda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01I (-) Total △PY%_Pin (Capped Pin)' =
			
			VAR _Value = [_01G Total △PY%_Pin]
			VAR CappedValue =
			    MIN(1, MAX(-1, _Value))
			
			RETURN
			IF(
			    CappedValue < 0,
			    CappedValue
			)
		displayFolder: Upper Tier
		lineageTag: 059878e5-9a65-4013-af62-bc14d1b321b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01J Total △PY%_Pin (Pin Head)' =
			
			VAR _Value = [_01G Total △PY%_Pin]
			RETURN
			IF(
			    ABS(_Value) <= 1,
			    _Value
			)
		displayFolder: Upper Tier
		lineageTag: 41bc1661-2e41-416e-96df-9b6f204dfc6a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01K Total △PY%_Pin (Outlier Indicator)' =
			
			VAR _Value = [_01G Total △PY%_Pin]
			RETURN
			SWITCH(
			    TRUE(),
			    _Value > 1, "▲",
			    _Value < -1, "▼",
			    BLANK()
			)
		displayFolder: Upper Tier
		lineageTag: 254f0467-b0f2-4109-a8a7-2b755e86309e

