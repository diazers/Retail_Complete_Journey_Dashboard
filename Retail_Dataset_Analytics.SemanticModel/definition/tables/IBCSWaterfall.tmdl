		lineageTag: 6236d937-491e-422e-aecb-ecaa6db075d8

	measure '_01 Net Sales' = SUM( Fact_Sales_GPMargin[SALES_VALUE] ) / 1000
		lineageTag: 204241e5-a145-4f5e-a086-5c9469dfd46c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_02 PY Net Sales' =
			
			IF(
			    HASONEVALUE( Dim_Date[Year] ),
			    CALCULATE(
			        [_01 Net Sales],
			        SAMEPERIODLASTYEAR( Dim_Date[CalendarDate] )
			    ),
			    BLANK()
			)
		lineageTag: af11093b-7ed2-4d35-890f-5b74aba25dfc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_03 △PY Net Sales' = ```
			
			IF(
			    HASONEVALUE(Dim_Date[Year]) 
			    && NOT(ISBLANK( [_02 PY Net Sales] )) 
			    && NOT(ISBLANK( [_01 Net Sales] )) 
			    && [_01 Net Sales] <> 0,
			    [_01 Net Sales] - [_02 PY Net Sales],
			    BLANK()
			)
			```
		lineageTag: 06c729c8-fd0b-4ea9-966f-293843cce96e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_04 △PY% Net Sales' =
			
			IF(
			    ISBLANK([_01 Net Sales]) || [_01 Net Sales] = 0,
			    "--",
			    DIVIDE([_01 Net Sales] - [_02 PY Net Sales], [_02 PY Net Sales], 0)
			)
		lineageTag: eba8c066-26da-4ba5-94fe-574765c8878d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_02 PY_Waterfall' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE( 'Table_Waterfall'[Category 1] ),
			        SELECTEDVALUE( 'Table_Waterfall'[Category 2] )  // Month hierarchy
			    )
			RETURN
			SWITCH(
			    CategoryValue,
			    "Previous Year", 
			        CALCULATE(
			            [_01 Net Sales], 
			            ALL('Dim_Date'),
			            Dim_Date[Year] = SelectedYear - 1,
			            REMOVEFILTERS('Table_Waterfall')
			        ),
			    BLANK()
			)
			```
		lineageTag: 4b538e76-138c-40d9-b085-827e09037c45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

