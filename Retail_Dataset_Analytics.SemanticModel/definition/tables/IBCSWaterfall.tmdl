	measure '_01C (-) Q-M/△PY%_Pin (Capped Pin)' =
			
			VAR _Value = [_01A Q-M/△PY%_Pin]
			VAR CappedValue =
			    MIN(1, MAX(-1, _Value))
			
			RETURN
			IF(
			    CappedValue < 0,
			    CappedValue
			)
		displayFolder: Upper Tier
		lineageTag: 81943477-ea8f-40d2-a0db-e12951fbdaf6

