		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01 AC_Columns' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE( Table_Waterfall[Category 1] ),
			        SELECTEDVALUE( Table_Waterfall[Category 2] )  // Month hierarchy
			    )
			VAR MonthNumber = SELECTEDVALUE( Table_Waterfall[Month Number] )
			VAR QuarterNumber = SELECTEDVALUE( Table_Waterfall[Quarter Number] )
			
			-- Check if period is in filter context
			VAR IsMonthInFilter = MonthNumber IN VALUES( Dim_Date[Month] )
			VAR IsQuarterInFilter = QuarterNumber IN VALUES( Dim_Date[Quarter] )
			
			-- Current Year Month Value
			VAR CurrentYearMonth = 
			    CALCULATE(
			        [_01 AC Net Sales], 
			        Dim_Date[Year] = SelectedYear, 
			        Dim_Date[Month] = MonthNumber
			    )
			
			-- Current Year Quarter Value
			VAR CurrentYearQuarter = 
			    CALCULATE(
			        [_01 AC Net Sales], 
			        Dim_Date[Year] = SelectedYear, 
			        Dim_Date[Quarter] = QuarterNumber
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    CategoryValue = "Monthly YoY" && IsMonthInFilter, CurrentYearMonth,
			    CategoryValue = "Quarterly YoY" && IsQuarterInFilter, CurrentYearQuarter,
			    BLANK()
			)
			```
		displayFolder: Lower Tier
		lineageTag: 807c63cf-d6dd-4764-9b62-517a3e05e03c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_02 PY_Columns' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE(Table_Waterfall[Category 1]),
			        SELECTEDVALUE(Table_Waterfall[Category 2])  // Month hierarchy
			    )
			VAR MonthNumber = SELECTEDVALUE( Table_Waterfall[Month Number] )
			VAR QuarterNumber = SELECTEDVALUE( Table_Waterfall[Quarter Number] )
			
			-- Check if period is in filter context
			VAR IsMonthInFilter = MonthNumber IN VALUES( Dim_Date[Month] )
			VAR IsQuarterInFilter = QuarterNumber IN VALUES( Dim_Date[Quarter] )
			
			-- Previous Year Month Value
			VAR PreviousYearMonth = 
			    CALCULATE(
			        [_01 AC Net Sales], 
			        Dim_Date[Year] = SelectedYear - 1, 
			        Dim_Date[Month] = MonthNumber
			    )
			
			-- Previous Year Quarter Value
			VAR PreviousYearQuarter = 
			    CALCULATE(
			        [_01 AC Net Sales], 
			        Dim_Date[Year] = SelectedYear - 1, 
			        Dim_Date[Quarter] = QuarterNumber
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    CategoryValue = "Monthly YoY" && IsMonthInFilter, PreviousYearMonth,
			    CategoryValue = "Quarterly YoY" && IsQuarterInFilter, PreviousYearQuarter,
			    BLANK()
			)
			```
		displayFolder: Lower Tier
		lineageTag: b70b002c-3480-4a83-8d1f-97f41e5a0221

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01A Q-M/△PY%_Pin' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE( Table_Waterfall[Category 1] ),
			        SELECTEDVALUE( Table_Waterfall[Category 2] )  // Month hierarchy
			    )
			VAR MonthNumber = SELECTEDVALUE( Table_Waterfall[Month Number] )
			VAR QuarterNumber = SELECTEDVALUE( Table_Waterfall[Quarter Number] )
			
			-- Check if period is in filter context
			VAR IsMonthInFilter = MonthNumber IN VALUES( Dim_Date[Month] )
			VAR IsQuarterInFilter = QuarterNumber IN VALUES( Dim_Date[Quarter] )
			
			-- Monthly percentage calculation
			VAR MonthlyPercentage = 
			    VAR CurrentYearMonth = 
			        CALCULATE(
			            [_01 AC Net Sales], 
			            Dim_Date[Year] = SelectedYear, 
			            Dim_Date[Month] = MonthNumber
			        )
			    VAR PreviousYearMonth = 
			        CALCULATE(
			            [_01 AC Net Sales], 
			            Dim_Date[Year] = SelectedYear - 1, 
			            Dim_Date[Month] = MonthNumber
			        )
			    RETURN DIVIDE( CurrentYearMonth - PreviousYearMonth, PreviousYearMonth )
			
			-- Quarterly percentage calculation
			VAR QuarterlyPercentage = 
			    VAR CurrentYearQuarter = 
			        CALCULATE(
			            [_01 AC Net Sales], 
			            Dim_Date[Year] = SelectedYear, 
			            Dim_Date[Quarter] = QuarterNumber
			        )
			    VAR PreviousYearQuarter = 
			        CALCULATE(
			            [_01 AC Net Sales], 
			            Dim_Date[Year] = SelectedYear - 1, 
			            Dim_Date[Quarter] = QuarterNumber
			        )
			    RETURN 
						    DIVIDE( CurrentYearQuarter - PreviousYearQuarter, PreviousYearQuarter )
			
			RETURN
			SWITCH(
			    TRUE(),
			    CategoryValue = "Monthly YoY" && IsMonthInFilter, MonthlyPercentage,
			    CategoryValue = "Quarterly YoY" && IsQuarterInFilter, QuarterlyPercentage,
			    BLANK()
			)
			```
		displayFolder: Upper Tier
		lineageTag: 041202ee-ebe0-467a-b755-bc08606625f7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01B (+) Q-M/△PY%_Pin (Capped Pin)' =
			
			VAR _Value = [_01A Q-M/△PY%_Pin]
			VAR CappedValue =
			    MIN(1, MAX(-1, _Value))
			
			RETURN
			IF(
			    CappedValue > 0,
			    CappedValue
			)
		displayFolder: Upper Tier
		lineageTag: a3abbca6-b0f4-44b1-b6f0-990b6dc8b16c

