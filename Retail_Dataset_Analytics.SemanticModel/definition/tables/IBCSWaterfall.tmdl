			)
		lineageTag: ef0c50b4-bae2-4b7e-991b-c9fe3403721f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_05 Base Bar_Q-M/△PY' = ```
			
			VAR SelectedYear = CALCULATE(MAX('Dim_Date'[Year]), ALLSELECTED('Dim_Date'[Year]))
			
			VAR IsSingleMonth = 
			    HASONEVALUE('Table_Waterfall'[Month Number]) 
			    && SELECTEDVALUE('Table_Waterfall'[Month Number]) > 0
			VAR IsSingleQuarter = 
			    NOT(IsSingleMonth)
			    && HASONEVALUE('Table_Waterfall'[Quarter Number]) 
			    && SELECTEDVALUE('Table_Waterfall'[Quarter Number]) > 0
			
			VAR CurrentMonthNo = SELECTEDVALUE('Table_Waterfall'[Month Number])
			VAR CurrentQuarterNo = SELECTEDVALUE('Table_Waterfall'[Quarter Number])
			
			VAR PYBase = 
			    CALCULATE(
			        [_01 Net Sales],
			        ALL('Dim_Date'),
			        'Dim_Date'[Year] = SelectedYear - 1,
			        REMOVEFILTERS('Table_Waterfall')
			    )
			
			-- ===== MONTH GRAIN =====
			VAR CumulativePriorVarianceM = 
			    SUMX(
			        FILTER(
			            ALL('Table_Waterfall'),
			            'Table_Waterfall'[Month Number] < CurrentMonthNo
			                && 'Table_Waterfall'[Month Number] > 0
			        ),
			        VAR PriorMonthNo = 'Table_Waterfall'[Month Number]
			        RETURN
			        CALCULATE(
			            [_03 △PY Net Sales],
			            TREATAS({ PriorMonthNo }, 'Dim_Date'[Month])
			        )
			    )
			
			VAR CurrentMonthVariance = 
			    CALCULATE(
			        [_03 △PY Net Sales],
			        TREATAS({ CurrentMonthNo }, 'Dim_Date'[Month])
			    )
			
			VAR BaseHeightM = 
			    IF(
			        CurrentMonthVariance < 0,
			        PYBase + COALESCE(CumulativePriorVarianceM, 0) + CurrentMonthVariance,
			        PYBase + COALESCE(CumulativePriorVarianceM, 0)
			    )
			
			-- ===== QUARTER GRAIN (dedupe rows first — table has 3 rows per quarter) =====
			VAR CumulativePriorVarianceQ =
			    SUMX(
			        FILTER(
			            SUMMARIZE( ALL('Table_Waterfall'), 'Table_Waterfall'[Quarter Number] ),
			            'Table_Waterfall'[Quarter Number] < CurrentQuarterNo
			                && 'Table_Waterfall'[Quarter Number] > 0
			        ),
			        VAR PriorQuarterNo = 'Table_Waterfall'[Quarter Number]
			        RETURN
			        CALCULATE(
			            [_03 △PY Net Sales],
			            TREATAS({ PriorQuarterNo }, 'Dim_Date'[Quarter])
			        )
			    )
			
			VAR CurrentQuarterVariance =
			    CALCULATE(
			        [_03 △PY Net Sales],
			        TREATAS({ CurrentQuarterNo }, 'Dim_Date'[Quarter])
			    )
			
			VAR BaseHeightQ =
			    IF(
			        CurrentQuarterVariance < 0,
			        PYBase + COALESCE(CumulativePriorVarianceQ, 0) + CurrentQuarterVariance,
			        PYBase + COALESCE(CumulativePriorVarianceQ, 0)
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsSingleMonth,   BaseHeightM,
			    IsSingleQuarter, BaseHeightQ,
			    BLANK()
			)
			```
		lineageTag: a485d906-6534-414a-85cd-22fe98249a5f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_05A Base Bar_(+) Q-M/△PY' = ```
			
			VAR CurrentSortOrder = SELECTEDVALUE('Table_Waterfall'[Sort Order 2])
			VAR CurrentVariance = 
			    CALCULATE(
			        [_03 △PY Net Sales],
			        TREATAS({ CurrentSortOrder }, 'Dim_Date'[Month])
			    )
			
			RETURN
			IF(
			    CurrentVariance >= 0,
			    [_05 Base Bar_Q-M/△PY],
			    BLANK()
			)
			```
		lineageTag: 5366021c-896a-4bf8-a87b-3ef6b9c4e262

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_05B Base Bar_(-) Q-M/△PY' = ```
			
			VAR CurrentSortOrder = SELECTEDVALUE('Table_Waterfall'[Sort Order 2])
			VAR CurrentVariance = 
			    CALCULATE(
			        [_03 △PY Net Sales],
			        TREATAS({ CurrentSortOrder }, 'Dim_Date'[Month])
			    )
			
			RETURN
			IF(
			    CurrentVariance < 0,
			    [_05 Base Bar_Q-M/△PY],
			    BLANK()
			)
			```
		lineageTag: ea923a40-eda2-4aad-8640-bfc78a7df0cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_06 Base Bar_Total △PY' = ```
			
			VAR SelectedYear = SELECTEDVALUE( Dim_Date[Year] )
			VAR SelectedHierarchyOrder = SELECTEDVALUE( PHierarchy[PHierarchy Order] )
			VAR CategoryValue = 
			    IF(
			        SelectedHierarchyOrder = 0,  // Quarter hierarchy
			        SELECTEDVALUE( 'Table_Waterfall'[Category 1] ),
			        SELECTEDVALUE( 'Table_Waterfall'[Category 2] )  // Month hierarchy
			    )
			VAR CurrentMonthlySortOrder = SELECTEDVALUE( 'Table_Waterfall'[Sort Order 2] )
			VAR CurrentQuarterlySortOrder = SELECTEDVALUE( 'Table_Waterfall'[Sort Order 1] )
			
			-- Previous Year Total (respects filtering)
			VAR PreviousYearValue = 
			    CALCULATE(
			        [_01 Net Sales], 
			        Dim_Date[Year] = SelectedYear - 1
			    )
			
			-- Current Year Total (respects filtering)
			VAR CurrentYearValue = 
			    CALCULATE(
			        [_01 Net Sales], 
			        Dim_Date[Year] = SelectedYear
			    )
			
			-- Calculate variance
			VAR VarianceAmount = CurrentYearValue - PreviousYearValue
			
			-- Determine base value based on variance direction
			VAR BaseValue = IF(VarianceAmount > 0, PreviousYearValue, CurrentYearValue)
			
			RETURN
			SWITCH(
			    TRUE(),
			    CategoryValue = "Total YoY" && CurrentMonthlySortOrder = 14, BaseValue,
			    CategoryValue = "Total YoY" && CurrentQuarterlySortOrder = 6, BaseValue,
			    BLANK()
			)
			```
		lineageTag: af222bcd-6573-4111-9c9a-4b4b6fc0d040

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_01 AC Net Sales' =
			
			VAR CurrentYear = SELECTEDVALUE('Dim_Date'[Year])
			RETURN
			CALCULATE(
			    [_01 Net Sales],
			    Dim_Date[Year] = CurrentYear,
			    REMOVEFILTERS('Table_Waterfall')
			)
		lineageTag: f97806b4-f564-4bb0-81c9-705328f25f64

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_00 Y-Axis Max. Range' = ```
			
			VAR SelectedHierarchyOrder = SELECTEDVALUE( 'PHierarchy'[PHierarchy Order] )
			
			-- Find highest value from base bars (Running Total)
			VAR HighestBaseBar = 
			    IF(
			        SelectedHierarchyOrder = 0,
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 1] ), [_05 Base Bar_Q-M/△PY] ),
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 2] ), [_05 Base Bar_Q-M/△PY] )
			    )
			
			-- Find highest AC value (from _01 AC_Waterfall measure)
			VAR HighestACBar = 
			    IF(
			        SelectedHierarchyOrder = 0,
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 1] ), [_01 AC_Waterfall] ),
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 2] ), [_01 AC_Waterfall] )
			    )
			
			-- Find highest PY value (from _02 PY_Waterfall measure)
			VAR HighestPYBar = 
			    IF(
			        SelectedHierarchyOrder = 0,
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 1] ), [_02 PY_Waterfall] ),
			        MAXX( ALL( 'Table_Waterfall'[Hierarchy 2] ), [_02 PY_Waterfall] )
			    )
			
			-- Find the maximum across all five values
			VAR HighestValue = 
			    MAXX(
			        {
			            HighestBaseBar,
			            HighestACBar,
			            HighestPYBar
			        },
			        [Value]
			    )
			
			RETURN
			    HighestValue * 1.2
			```
		lineageTag: cc9d5794-ce0a-4424-b9ba-b071bbd62b48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

